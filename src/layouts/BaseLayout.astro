---
import '../styles/tokens.css';
import '../styles/broadsheet.css';
import Footer from '../components/Footer.astro';
import SubscribeModal from '../components/SubscribeModal.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  hideFooter?: boolean;
}

const {
  title,
  description = 'The Financial Crimes — Independent satirical-yet-factually-grounded digital broadsheet covering global white-collar, corporate, regulatory, and political financial crimes. All the Crimes Fit to Fine.',
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  hideFooter = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://financialcrimes.news').toString();
const faviconSvg =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23121212'/%3E%3Ctext x='50%25' y='54%25' dominant-baseline='middle' text-anchor='middle' font-family='Georgia,serif' font-size='34' font-weight='700' fill='%23ffffff'%3EFC%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <meta property="og:site_name" content="The Financial Crimes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600;700&family=Libre+Franklin:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=UnifrakturMaguntia&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="fc-skip-link" href="#main-content">Skip to main content</a>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    {!hideFooter && <Footer />}

    <SubscribeModal />
    <slot name="modals" />

    <script>
      function wireGlobalDialogs() {
        const subDialog = document.getElementById('fc-subscribe-dialog') as HTMLDialogElement | null;
        const tipDialog = document.getElementById('fc-tipline-dialog') as HTMLDialogElement | null;

        document.addEventListener('click', (event) => {
          const target = event.target as HTMLElement | null;
          if (!target) return;

          const subTrigger = target.closest('[data-open-subscribe]');
          if (subTrigger && subDialog) {
            event.preventDefault();
            if (!subDialog.open) subDialog.showModal();
            return;
          }

          const tipTrigger = target.closest('[data-open-tipline]');
          if (tipTrigger && tipDialog) {
            event.preventDefault();
            if (!tipDialog.open) tipDialog.showModal();
            return;
          }

          const closeBtn = target.closest('[data-close-dialog]');
          if (closeBtn) {
            const dlg = closeBtn.closest('dialog') as HTMLDialogElement | null;
            if (dlg && dlg.open) dlg.close();
          }
        });

        // Allow clicking native backdrop to close any .fc-dialog
        document.querySelectorAll('dialog.fc-dialog').forEach((node) => {
          const dlg = node as HTMLDialogElement;
          dlg.addEventListener('click', (e) => {
            if (e.target === dlg) dlg.close();
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', wireGlobalDialogs);
      } else {
        wireGlobalDialogs();
      }
    </script>
  </body>
</html>
