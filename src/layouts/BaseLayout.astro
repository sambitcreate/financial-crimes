---
import '../styles/tokens.css';
import '../styles/broadsheet.css';
import '../styles/sidebar-mobile.css';
// <fc-painting> frame styles live in the shared, cacheable stylesheet rather than inline in every page
import '../painting/fc-art.css';
import Footer from '../components/Footer.astro';
import NavDrawer from '../components/NavDrawer.astro';
import SubscribeModal from '../components/SubscribeModal.astro';
import { loadAllArticles, loadEdition, loadRollupStats } from '../loaders/articles';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  hideFooter?: boolean;
  /** Error pages: no canonical/og:url (every missing URL would claim /404), and keep out of search. */
  noindex?: boolean;
  /** Reference image of the above-the-fold hero painting, fetched during HTML parse instead of after the painting script boots. */
  preloadImage?: string;
}

const {
  title,
  description = 'The Financial Crimes — Daily broadsheet tracking global white-collar crime, regulatory fines, and prison time. All the Crimes Fit to Fine.',
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  ogImage = '/og-card.png',
  ogImageAlt = 'The Financial Crimes — All the Crimes Fit to Fine — Global White-Collar Crime Ledger',
  publishedTime,
  jsonLd,
  hideFooter = false,
  noindex = false,
  preloadImage,
} = Astro.props;

const [navArticles, navRollup, latestEdition] = await Promise.all([
  loadAllArticles(),
  loadRollupStats(),
  loadEdition(),
]);

const editionVolume = latestEdition?.volume ?? 'Vol. I';
const siteBase = Astro.site ?? new URL('https://financialcrimes.news');
const normalizedCanonicalPath =
  canonicalPath === '/' || canonicalPath === '/index.html'
    ? '/'
    : canonicalPath.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const canonicalUrl = new URL(normalizedCanonicalPath, siteBase).toString();
const ogImageUrl = new URL(ogImage, siteBase).toString();
const rssUrl = new URL('/rss.xml', siteBase).toString();
const serializedJsonLd = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, '\\u003c')
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="The Financial Crimes RSS Feed" href={rssUrl} />

    <meta property="og:site_name" content="The Financial Crimes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {serializedJsonLd && <script type="application/ld+json" set:html={serializedJsonLd} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Only faces some rule renders: nothing sets Newsreader 400 italic or Source Serif 4 at 600 */}
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600;700&family=Libre+Franklin:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400&family=UnifrakturMaguntia&display=swap"
      rel="stylesheet"
    />
    {
      /* crossorigin matches the painting's anonymous-CORS Image() load so the preloaded response is reused */
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} crossorigin="anonymous" />
      )
    }
  </head>
  <body>
    <a class="fc-skip-link" href="#main-content">Skip to main content</a>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    {!hideFooter && <Footer editionDate={navRollup.edition_date} volume={editionVolume} />}

    <NavDrawer
      articles={navArticles}
      rollup={navRollup}
      volume={editionVolume}
      currentPath={Astro.url.pathname}
    />
    <SubscribeModal />
    <slot name="modals" />

    <script>
      function wireGlobalDialogs() {
        const subDialog = document.getElementById('fc-subscribe-dialog') as HTMLDialogElement | null;
        const tipDialog = document.getElementById('fc-tipline-dialog') as HTMLDialogElement | null;
        const lastTriggers = new WeakMap<HTMLDialogElement, HTMLElement>();

        function openManagedDialog(dlg: HTMLDialogElement, trigger?: HTMLElement | null) {
          if (trigger) {
            lastTriggers.set(dlg, trigger);
          } else if (document.activeElement instanceof HTMLElement) {
            lastTriggers.set(dlg, document.activeElement);
          }
          if (!dlg.open) dlg.showModal();
        }

        document.addEventListener('click', (event) => {
          const target = event.target as HTMLElement | null;
          if (!target) return;
          if (target.closest('#fc-nav-drawer')) return;

          const subTrigger = target.closest<HTMLElement>('[data-open-subscribe]');
          if (subTrigger && subDialog) {
            event.preventDefault();
            openManagedDialog(subDialog, subTrigger);
            return;
          }

          const tipTrigger = target.closest<HTMLElement>('[data-open-tipline]');
          if (tipTrigger && tipDialog) {
            event.preventDefault();
            openManagedDialog(tipDialog, tipTrigger);
            return;
          }

          const closeBtn = target.closest('[data-close-dialog]');
          if (closeBtn) {
            const dlg = closeBtn.closest('dialog') as HTMLDialogElement | null;
            if (dlg && dlg.open) dlg.close();
          }
        });

        // Allow clicking native backdrop to close any .fc-dialog and restore focus to trigger
        document.querySelectorAll('dialog.fc-dialog').forEach((node) => {
          const dlg = node as HTMLDialogElement;
          dlg.addEventListener('click', (e) => {
            if (e.target === dlg) dlg.close();
          });
          dlg.addEventListener('close', () => {
            const trigger = lastTriggers.get(dlg);
            if (trigger && document.contains(trigger)) {
              trigger.focus();
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', wireGlobalDialogs);
      } else {
        wireGlobalDialogs();
      }
    </script>
  </body>
</html>
