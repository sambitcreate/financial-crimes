---
import { accentToMood } from '../painting/palette';
import { resolvePaintRef } from '../painting/refs-loader';
import type { PaintMode, PaintRefConfig, ToyKind } from '../painting/types';

export interface Props {
  id: string;
  slug?: string;
  spec: {
    archetype?: string;
    accent?: string;
    theme?: 'newsprint' | 'monochrome';
    caption?: string;
    credit?: string;
    data?: Record<string, any>;
  };
  mode?: 'hero' | 'inline' | 'thumb';
  aspect?: '4/5' | '16/9' | '16/10' | '1/1' | '4/3';
  showCaption?: boolean;
  alt?: string;
}

const {
  id,
  slug,
  spec,
  mode = 'inline',
  aspect = '16/10',
  showCaption,
  alt,
} = Astro.props;

const safeMode: PaintMode = mode === 'hero' || mode === 'thumb' ? mode : 'inline';
const safeAspect =
  aspect === '4/5' || aspect === '16/9' || aspect === '16/10' || aspect === '1/1' || aspect === '4/3'
    ? aspect
    : '16/10';

const ASPECT_RATIO_MAP: Record<typeof safeAspect, number> = {
  '4/5': 4 / 5,
  '16/9': 16 / 9,
  '16/10': 16 / 10,
  '1/1': 1,
  '4/3': 4 / 3,
};

const { slug: resolvedSlug, entry } = await resolvePaintRef({
  id,
  slug,
  caption: spec?.caption,
});

const isMonochrome =
  spec?.theme === 'monochrome' || entry?.paletteMood === 'monochrome-noir';

const paletteMood = isMonochrome
  ? 'monochrome-noir'
  : (entry?.paletteMood ?? accentToMood(spec?.accent, spec?.theme));

const toyKind: ToyKind = entry?.toyKind ?? 'stamp';

const resolvedAlt =
  alt ||
  entry?.alt ||
  (entry?.subject
    ? `Impressionist oil painting of ${entry.subject}`
    : spec?.caption || 'Impressionist editorial oil painting by The Financial Crimes');

// Only what the client reads (alt lives on the stage's aria-label; mode/aspect also on data-*)
const paintingConfig: PaintRefConfig = {
  slug: resolvedSlug,
  refImage: entry?.refImage,
  isPortrait: entry?.isPortrait ?? true,
  focalPoint: entry?.focalPoint,
  paletteMood,
  toyKind,
  toyText: entry?.toyText,
  toySubtext: entry?.toySubtext,
  monochrome: isMonochrome,
  aspect: ASPECT_RATIO_MAP[safeAspect],
  mode: safeMode,
};

const serializedConfig = JSON.stringify(paintingConfig).replace(/</g, '\\u003c');
const aspectCss = safeAspect.replace('/', ' / ');
const isInteractive = safeMode !== 'thumb';
const captionText = spec?.caption || '';
const creditText =
  spec?.credit && !spec.credit.startsWith('Interactive Illustration')
    ? spec.credit
    : 'Oil Study · The Financial Crimes';
const renderCaption = showCaption ?? (safeMode !== 'thumb' && Boolean(captionText));
---

<figure
  class="fc-art-figure"
  data-mode={safeMode}
  data-slug={resolvedSlug}
>
  <fc-painting
    class="fc-painting-shell"
    data-id={id}
    data-slug={resolvedSlug}
    data-mode={safeMode}
    data-aspect={safeAspect}
    data-theme={isMonochrome ? 'monochrome' : 'newsprint'}
    style={`--fc-art-aspect: ${aspectCss};`}
  >
    <div class="fc-painting-stage" role="img" aria-label={resolvedAlt}>
      <canvas class="fc-painting-layer fc-painting-layer--ground" data-layer="ground" aria-hidden="true"></canvas>
      <canvas class="fc-painting-layer fc-painting-layer--weave" data-layer="weave" aria-hidden="true"></canvas>
      <canvas class="fc-painting-layer fc-painting-layer--live" data-layer="live" aria-hidden="true"></canvas>
    </div>

    {
      isInteractive && (
        <button
          type="button"
          class="fc-painting-repaint"
          data-fc-repaint
          aria-label="Repaint portrait"
          title="Repaint portrait"
        >
          ↻
        </button>
      )
    }

    <script type="application/json" class="fc-painting-config" set:html={serializedConfig} />
  </fc-painting>

  {
    renderCaption && captionText && (
      <figcaption class="fc-art-figcaption">
        <span class="fc-art-caption-text">{captionText}</span>
        {creditText && <span class="fc-art-credit">{creditText}</span>}
      </figcaption>
    )
  }
</figure>

<script>
  import '../painting/element';
</script>
