---
/**
 * The Running Ledger. Rendered at /ledger (page 1) and /ledger/page/N so every filing is
 * reachable without JavaScript; with JavaScript, filters/search/sort re-render client-side
 * from /ledger-index.json and the URL tracks the view (/ledger?q=…&page=N).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactHeader from './CompactHeader.astro';
import FcArt from './FcArt.astro';
import { loadAllArticles, loadRollupStats } from '../loaders/articles';
import { getPaintRefLookup } from '../painting/refs-loader';
import {
  formatBroadsheetDate,
  formatLegalStage,
  formatShortDate,
  formatStageFineRatio,
  formatUsdShort,
  penaltyLabel,
} from '../utils/format';
import {
  buildLedgerEntries,
  computeFilteredTotals,
  LEDGER_PAGE_SIZE,
  ledgerPagePath,
  listedArticles,
  paginateItems,
} from '../utils/ledger';

interface Props {
  page?: number;
}

const { page = 1 } = Astro.props;

const [loadedArticles, rollup, { manifest }] = await Promise.all([
  loadAllArticles(),
  loadRollupStats(),
  getPaintRefLookup(),
]);
const articles = listedArticles(loadedArticles);

const initialPage = paginateItems(articles, page, LEDGER_PAGE_SIZE);
const initialArticles = initialPage.items;
// Same definition the client uses after filtering, so the strip never jumps on first input
const initialTotals = computeFilteredTotals(buildLedgerEntries(articles, manifest));
const prevHref = initialPage.page > 1 ? ledgerPagePath(initialPage.page - 1) : null;
const nextHref = initialPage.page < initialPage.totalPages ? ledgerPagePath(initialPage.page + 1) : null;
const pageTitle =
  initialPage.page > 1
    ? `The Ledger — Page ${initialPage.page} — The Financial Crimes`
    : 'The Ledger — The Financial Crimes';

const categories = Array.from(new Set(articles.map((a) => a.category))).sort();
const editions = [
  { key: 'all', label: 'All Bureaus' },
  { key: 'us', label: 'U.S.' },
  { key: 'new-york', label: 'New York' },
  { key: 'chicago', label: 'Chicago' },
  { key: 'los-angeles', label: 'Los Angeles' },
  { key: 'london', label: 'London' },
  { key: 'india', label: 'India' },
  { key: 'europe', label: 'Europe' },
  { key: 'global', label: 'Singapore & HK' },
];

const topicLinks = [
  { label: 'Front Page', href: '/' },
  { label: 'Full Ledger', href: '/ledger', current: initialPage.page === 1 },
  { label: '$1B+ Cases', href: '/ledger?magnitude=1000000000' },
  { label: 'Zero Prison', href: '/ledger?slap=zero-prison' },
  { label: 'Archive', href: '/archive' },
  { label: "Today's Docket", href: `/edition/${rollup.edition_date}` },
];
---

<BaseLayout
  title={pageTitle}
  description="Searchable ledger of global white-collar crime, fines, fine-to-loot ratios, and prison sentences."
  canonicalPath={ledgerPagePath(initialPage.page)}
>
  <CompactHeader
    slot="header"
    showTopicBar={true}
    topicTitle="The Ledger"
    topicLinks={topicLinks}
  />

  <div
    class="fc-container"
    id="fc-ledger-root"
    data-total-cases={articles.length}
    data-page-size={LEDGER_PAGE_SIZE}
    data-initial-page={initialPage.page}
    style="padding-bottom: 56px;"
  >
    {/* Ledger Hero Header */}
    <header class="fc-ledger-hero">
      <h1 class="fc-ledger-title" style="margin-top: 0;">The Running Ledger</h1>
      <p style="font-family: var(--fc-font-body); font-size: 16.5px; color: var(--fc-ink-muted); max-width: 640px; margin: 0;">
        Every indictment, consent order, fine ratio, and prison sentence on our docket. Pending
        cases show their status, never a fine.
      </p>

      {/* Live Dynamic Totals Strip */}
      <div class="fc-ledger-totals" aria-live="polite">
        <div>
          <span class="fc-docket-stat-label">Cases</span>
          <span class="fc-docket-stat-val" id="fc-ledger-total-count" style="font-size: 18px;">
            {initialTotals.count}
          </span>
        </div>
        <div>
          <span class="fc-docket-stat-label" title="Alleged (pending) plus adjudicated amounts">Scale at Issue</span>
          <span class="fc-docket-stat-val" id="fc-ledger-total-loot" style="font-size: 18px;">
            {formatUsdShort(initialTotals.totalLoot)}
          </span>
        </div>
        <div>
          <span class="fc-docket-stat-label" title="Resolved cases only; money frozen in pending cases is not a fine">Penalties Imposed</span>
          <span class="fc-docket-stat-val" id="fc-ledger-total-fines" style="font-size: 18px;">
            {formatUsdShort(initialTotals.totalFines)}
          </span>
        </div>
        <div>
          <span class="fc-docket-stat-label" title="Penalties as a share of the scale of resolved cases">Fine / Scale (Resolved)</span>
          <span
            class="fc-docket-stat-val"
            id="fc-ledger-avg-ratio"
            style="font-size: 18px; color: var(--fc-art-crimson);"
          >
            {initialTotals.avgFineRatioPct.toFixed(1)}%
          </span>
        </div>
      </div>
    </header>

    {/* Multi-Facet Filter Bar (sticky on desktop, static + collapsible drawer on mobile) */}
    <section class="fc-ledger-filterbar" id="fc-ledger-filterbar" aria-label="Filter and sort the Ledger" data-requires-js>
      <div class="fc-ledger-controls">
        <div class="fc-ledger-primary-row">
          <label class="fc-sr-only" for="fc-ledger-search">Search cases</label>
          <input
            type="search"
            id="fc-ledger-search"
            placeholder="Search cases, agencies..."
          />

          <div class="fc-view-toggle" role="group" aria-label="Ledger display mode">
            <button type="button" id="fc-view-editorial" aria-pressed="true">Editorial</button>
            <button type="button" id="fc-view-table" aria-pressed="false">Table</button>
          </div>
        </div>

        <details class="fc-ledger-mobile-drawer" id="fc-ledger-filter-drawer" open>
          <summary class="fc-ledger-drawer-summary">
            <span class="fc-ledger-drawer-summary-left">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M2 3.5h12M4.5 8h7M6.5 12.5h3"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                />
              </svg>
              <span>Filters &amp; Sort</span>
              <span class="fc-ledger-active-badge" id="fc-ledger-active-count" hidden>0</span>
            </span>
            <svg
              class="fc-ledger-drawer-chevron"
              width="12"
              height="12"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2.5 4.25L6 7.75L9.5 4.25"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
              />
            </svg>
          </summary>

          <div class="fc-ledger-drawer-grid">
            <label class="fc-sr-only" for="fc-ledger-edition">Bureau</label>
            <select id="fc-ledger-edition">
              {editions.map((ed) => (
                <option value={ed.key}>{ed.label}</option>
              ))}
            </select>

            <label class="fc-sr-only" for="fc-ledger-category">Category</label>
            <select id="fc-ledger-category">
              <option value="all">All Desks</option>
              {categories.map((cat) => (
                <option value={cat}>{cat}</option>
              ))}
            </select>

            <label class="fc-sr-only" for="fc-ledger-magnitude">Scale</label>
            <select id="fc-ledger-magnitude">
              <option value="0">Any Scale</option>
              <option value="10000000">$10M+</option>
              <option value="100000000">$100M+</option>
              <option value="500000000">$500M+</option>
              <option value="1000000000">$1B+</option>
            </select>

            <label class="fc-sr-only" for="fc-ledger-slap">Outcome</label>
            <select id="fc-ledger-slap">
              <option value="all">All Outcomes</option>
              <option value="70">Wrist-Slap &ge; 70</option>
              <option value="85">Wrist-Slap &ge; 85</option>
              <option value="zero-prison">Zero Prison</option>
              <option value="pending">Pending</option>
            </select>

            <label class="fc-sr-only" for="fc-ledger-sort">Sort order</label>
            <select id="fc-ledger-sort" class="fc-ledger-select-sort">
              <option value="newest">Sort: Newest</option>
              <option value="loot-desc">Sort: Largest Scale</option>
              <option value="fine-desc">Sort: Largest Fine</option>
              <option value="slap-desc">Sort: Highest Wrist-Slap</option>
              <option value="ratio-asc">Sort: Lowest Fine Ratio</option>
            </select>
          </div>
        </details>
        {/* No inline script (CSP): the module script below collapses this drawer on phones */}
      </div>
    </section>

    {/* Empty State */}
    <div
      id="fc-ledger-empty"
      hidden
      style="padding: 40px 20px; text-align: center; border-bottom: 1px solid var(--fc-rule-column);"
    >
      <p style="font-family: var(--fc-font-headline); font-size: 21px; margin: 0 0 10px;">
        No filings match those filters.
      </p>
      <button type="button" class="fc-btn-outline" id="fc-ledger-reset-btn">
        Reset Filters
      </button>
    </div>

    {/* VIEW 1: Editorial List (Initial page SSR; subsequent pages & queries hydrated from /ledger-index.json) */}
    <section id="fc-ledger-list-view" class="fc-ledger-editorial-list" aria-label="Case list">
      {initialArticles.map((item) => (
        <article class="fc-ledger-editorial-row" data-ledger-item data-slug={item.slug}>
          <div class="fc-ledger-date-col">
            <span class="fc-ledger-date-str">{formatShortDate(item.publish_date)}</span>
            <div class="fc-ledger-city-str">{item.city}</div>
            <div class="fc-ledger-slap-wrap">
              {item.slap_on_wrist_score !== null ? (
                <span
                  class:list={[
                    'fc-score-badge',
                    { 'fc-score-badge--high': item.slap_on_wrist_score >= 70 },
                  ]}
                >
                  SLAP {item.slap_on_wrist_score}
                </span>
              ) : (
                <span class="fc-score-badge fc-score-badge--pending">PENDING</span>
              )}
            </div>
          </div>

          <div class="fc-ledger-editorial-body">
            <span
              class:list={[
                'fc-eyebrow',
                { 'fc-eyebrow--opinion': item.template === 'opinion' },
              ]}
            >
              {item.template === 'opinion' ? 'OPINION' : item.agencies.join(', ')}
            </span>

            <h2 class="fc-ledger-editorial-headline">
              <a href={item.url} class="fc-headline-link">{item.headline}</a>
            </h2>

            <p class="fc-ledger-editorial-deck">{item.deck}</p>

            <div class="fc-ledger-card-stats">
              <span>SCALE <strong>{item.financials.amount_display}</strong></span>
              <span>{penaltyLabel(item.legal_stage)} <strong>{item.financials.fine_display}</strong></span>
              <span>
                RATIO{' '}
                <strong style="color: var(--fc-art-crimson);">
                  {formatStageFineRatio(item, 'Pending')}
                </strong>
              </span>
              <span>{item.financials.prison_display}</span>
            </div>
          </div>

          <a href={item.url} class="fc-ledger-editorial-thumb" aria-label={item.headline}>
            <FcArt
              id={`${item.id}-ledger`}
              slug={item.slug}
              spec={item.interactive_art_spec}
              mode="thumb"
              aspect="16/10"
              showCaption={false}
            />
          </a>
        </article>
      ))}
    </section>

    {/* VIEW 2: Spreadsheet Table */}
    <section id="fc-ledger-table-view" class="fc-ledger-table-wrap" hidden aria-label="Spreadsheet ledger">
      <div class="fc-ledger-table-cue" aria-hidden="true">
        <span class="fc-ledger-table-cue-pin">Case pinned</span>
        <span class="fc-ledger-table-cue-swipe">Swipe table &rarr;</span>
      </div>
      <div class="fc-ledger-table-scroller">
        <table class="fc-ledger-table">
          <thead>
            <tr>
              <th class="fc-ledger-col-case">Case</th>
              <th class="fc-ledger-col-bureau">Bureau &amp; Agencies</th>
              <th class="fc-ledger-col-desk">Desk</th>
              <th class="fc-ledger-col-scale">Scale</th>
              <th class="fc-ledger-col-penalty">Penalty</th>
              <th class="fc-ledger-col-ratio">Ratio</th>
              <th class="fc-ledger-col-custody">Custody</th>
              <th class="fc-ledger-col-slap">Wrist-Slap</th>
            </tr>
          </thead>
          <tbody id="fc-ledger-tbody">
            {initialArticles.map((item) => (
              <tr data-ledger-row data-slug={item.slug}>
                <td class="fc-ledger-col-case">
                  <a href={item.url} class="fc-headline-link fc-ledger-table-headline">
                    {item.headline}
                  </a>
                  <span class="fc-ledger-case-mobile-meta">
                    {item.city} &middot; {item.agencies[0]}
                  </span>
                  <span class="fc-ledger-table-sub">
                    {item.docket_number ?? formatLegalStage(item.legal_stage)} &middot; {formatBroadsheetDate(item.publish_date)}
                  </span>
                </td>
                <td class="fc-ledger-col-bureau">
                  <strong style="display: block;">{item.city}</strong>
                  <span style="font-size: 11px; color: var(--fc-ink-muted);">
                    {item.agencies.join(', ')}
                  </span>
                </td>
                <td class="fc-ledger-col-desk">{item.category}</td>
                <td class="fc-ledger-num fc-ledger-col-scale"><strong>{item.financials.amount_display}</strong></td>
                <td class="fc-ledger-num fc-ledger-col-penalty">{item.financials.fine_display}</td>
                <td class="fc-ledger-num fc-ledger-col-ratio" style="color: var(--fc-art-crimson); font-weight: 600;">
                  {formatStageFineRatio(item, '—')}
                </td>
                <td class="fc-ledger-num fc-ledger-col-custody">{item.financials.prison_display}</td>
                <td class="fc-ledger-num fc-ledger-col-slap">
                  {item.slap_on_wrist_score !== null ? (
                    <span
                      class:list={[
                        'fc-score-badge',
                        { 'fc-score-badge--high': item.slap_on_wrist_score >= 70 },
                      ]}
                    >
                      {item.slap_on_wrist_score}/100
                    </span>
                  ) : (
                    <span class="fc-score-badge fc-score-badge--pending">PENDING</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* Pagination Bar */}
    <nav class="fc-pagination" id="fc-ledger-pagination" aria-label="Ledger pagination">
      <span class="fc-pagination-summary" id="fc-ledger-page-summary">
        {initialPage.totalItems > 0
          ? `Showing ${initialPage.startIndex}–${initialPage.endIndex} of ${initialPage.totalItems} filings`
          : '0 filings'}
      </span>
      {/* Real links to the prerendered /ledger/page/N files: pagination works without JavaScript */}
      <div class="fc-pagination-controls" id="fc-ledger-page-controls" hidden={initialPage.totalPages <= 1}>
        <a
          class="fc-btn-outline fc-pagination-btn"
          id="fc-ledger-prev"
          href={prevHref ?? undefined}
          rel={prevHref ? 'prev' : undefined}
          aria-disabled={prevHref ? undefined : 'true'}
        >
          &larr; Previous
        </a>
        <span class="fc-pagination-status" id="fc-ledger-page-status">
          Page {initialPage.page} of {initialPage.totalPages}
        </span>
        <a
          class="fc-btn-outline fc-pagination-btn"
          id="fc-ledger-next"
          href={nextHref ?? undefined}
          rel={nextHref ? 'next' : undefined}
          aria-disabled={nextHref ? undefined : 'true'}
        >
          Next &rarr;
        </a>
      </div>
    </nav>
  </div>
</BaseLayout>

<script>
  import '../painting/element';
  import { formatUsdShort } from '../utils/format';
  import {
    buildLedgerUrl,
    computeFilteredTotals,
    filterAndSortLedger,
    hasActiveLedgerFilters,
    LEDGER_PAGE_SIZE,
    paginateItems,
    type LedgerEntry,
    type LedgerUrlState,
  } from '../utils/ledger';

  const root = document.getElementById('fc-ledger-root');
  const pageSize = Number(root?.dataset.pageSize || LEDGER_PAGE_SIZE) || LEDGER_PAGE_SIZE;
  const totalCasesInitial = Number(root?.dataset.totalCases || 0);

  const filterBar = document.getElementById('fc-ledger-filterbar');
  const searchInput = document.getElementById('fc-ledger-search') as HTMLInputElement | null;
  const editionSel = document.getElementById('fc-ledger-edition') as HTMLSelectElement | null;
  const categorySel = document.getElementById('fc-ledger-category') as HTMLSelectElement | null;
  const magnitudeSel = document.getElementById('fc-ledger-magnitude') as HTMLSelectElement | null;
  const slapSel = document.getElementById('fc-ledger-slap') as HTMLSelectElement | null;
  const sortSel = document.getElementById('fc-ledger-sort') as HTMLSelectElement | null;

  const listView = document.getElementById('fc-ledger-list-view');
  const tableView = document.getElementById('fc-ledger-table-view');
  const tbody = document.getElementById('fc-ledger-tbody');
  const emptyEl = document.getElementById('fc-ledger-empty');
  const resetBtn = document.getElementById('fc-ledger-reset-btn');

  const btnEditorial = document.getElementById('fc-view-editorial');
  const btnTable = document.getElementById('fc-view-table');
  const filterDrawer = document.getElementById('fc-ledger-filter-drawer') as HTMLDetailsElement | null;
  const activeCountBadge = document.getElementById('fc-ledger-active-count');

  const countOut = document.getElementById('fc-ledger-total-count');
  const lootOut = document.getElementById('fc-ledger-total-loot');
  const finesOut = document.getElementById('fc-ledger-total-fines');
  const ratioOut = document.getElementById('fc-ledger-avg-ratio');

  const paginationNav = document.getElementById('fc-ledger-pagination');
  const pageSummary = document.getElementById('fc-ledger-page-summary');
  const pageControls = document.getElementById('fc-ledger-page-controls');
  const pageStatus = document.getElementById('fc-ledger-page-status');
  const prevBtn = document.getElementById('fc-ledger-prev') as HTMLAnchorElement | null;
  const nextBtn = document.getElementById('fc-ledger-next') as HTMLAnchorElement | null;

  // Sync collapsible filter drawer across viewport breakpoint changes
  if (filterDrawer && window.matchMedia) {
    const mobileMq = window.matchMedia('(max-width: 760px)');
    const syncDrawerForViewport = (matchesMobile: boolean) => {
      filterDrawer.open = !matchesMobile;
    };
    syncDrawerForViewport(mobileMq.matches);
    mobileMq.addEventListener('change', (e) => syncDrawerForViewport(e.matches));
  }

  let allEntries: LedgerEntry[] | null = null;
  let indexPromise: Promise<LedgerEntry[]> | null = null;
  let currentPage = Math.max(1, Number(root?.dataset.initialPage || 1) || 1);
  let currentView: 'editorial' | 'table' = 'editorial';
  let renderedListSlugs = Array.from(document.querySelectorAll<HTMLElement>('[data-ledger-item]')).map(
    (el) => el.dataset.slug || ''
  );
  let renderedTableSlugs = Array.from(document.querySelectorAll<HTMLElement>('[data-ledger-row]')).map(
    (el) => el.dataset.slug || ''
  );

  async function ensureLedgerIndex(): Promise<LedgerEntry[]> {
    if (allEntries) return allEntries;
    if (!indexPromise) {
      indexPromise = fetch('/ledger-index.json')
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        })
        .then((data: { entries?: LedgerEntry[] }) => {
          allEntries = Array.isArray(data.entries) ? data.entries : [];
          return allEntries;
        })
        .catch(() => {
          indexPromise = null;
          return [];
        });
    }
    return indexPromise;
  }

  let pagefindApi: any = null;
  // Pagefind hits are only valid for the query that produced them (no stale merges)
  let pagefindResult: { q: string; slugs: Set<string> } | null = null;
  let pagefindSeq = 0;
  let pagefindPromise: Promise<any> | null = null;
  let pagefindUnavailable = Boolean(import.meta.env.DEV);

  async function ensurePagefind() {
    if (pagefindApi) return pagefindApi;
    if (pagefindUnavailable) return null;
    if (!pagefindPromise) {
      pagefindPromise = (async () => {
        try {
          const pfPath = '/pagefind/pagefind.js';
          const mod = await import(/* @vite-ignore */ pfPath);
          if (mod?.init) await mod.init();
          pagefindApi = mod;
          return mod;
        } catch {
          pagefindUnavailable = true;
          pagefindApi = null;
          return null;
        }
      })();
    }
    return pagefindPromise;
  }

  function sameSlugOrder(a: string[], b: string[]): boolean {
    return a.length === b.length && a.every((slug, i) => slug === b[i]);
  }

  function createThumbPainting(entry: LedgerEntry): HTMLElement {
    const figure = document.createElement('figure');
    figure.className = 'fc-art-figure';
    figure.dataset.mode = 'thumb';
    figure.dataset.slug = entry.slug;

    const painting = document.createElement('fc-painting');
    painting.className = 'fc-painting-shell';
    painting.dataset.id = `${entry.id}-ledger`;
    painting.dataset.slug = entry.slug;
    painting.dataset.mode = 'thumb';
    painting.dataset.aspect = '16/10';
    painting.dataset.theme = entry.paintRef.monochrome ? 'monochrome' : 'newsprint';
    painting.style.setProperty('--fc-art-aspect', '16 / 10');

    const stage = document.createElement('div');
    stage.className = 'fc-painting-stage';
    stage.setAttribute('role', 'img');
    stage.setAttribute('aria-label', entry.paintRef.alt);

    // Thumbnails have no live layer (no toys/plates), so no third canvas backing store
    (['ground', 'weave'] as const).forEach((layer) => {
      const canvas = document.createElement('canvas');
      canvas.className = `fc-painting-layer fc-painting-layer--${layer}`;
      canvas.dataset.layer = layer;
      canvas.setAttribute('aria-hidden', 'true');
      stage.appendChild(canvas);
    });

    const configScript = document.createElement('script');
    configScript.type = 'application/json';
    configScript.className = 'fc-painting-config';
    configScript.textContent = JSON.stringify({
      slug: entry.paintRef.slug,
      refImage: entry.paintRef.refImage,
      isPortrait: entry.paintRef.isPortrait,
      focalPoint: entry.paintRef.focalPoint,
      paletteMood: entry.paintRef.paletteMood,
      toyKind: entry.paintRef.toyKind,
      toyText: entry.paintRef.toyText,
      toySubtext: entry.paintRef.toySubtext,
      monochrome: entry.paintRef.monochrome,
      aspect: 16 / 10,
      mode: 'thumb',
    });

    painting.appendChild(stage);
    painting.appendChild(configScript);
    figure.appendChild(painting);
    return figure;
  }

  function createEditorialCard(entry: LedgerEntry): HTMLElement {
    const article = document.createElement('article');
    article.className = 'fc-ledger-editorial-row';
    article.dataset.ledgerItem = '';
    article.dataset.slug = entry.slug;

    // Column 1: Date, City, Slap badge
    const dateCol = document.createElement('div');
    dateCol.className = 'fc-ledger-date-col';

    const dateSpan = document.createElement('span');
    dateSpan.className = 'fc-ledger-date-str';
    dateSpan.textContent = entry.short_date;
    dateCol.appendChild(dateSpan);

    const cityDiv = document.createElement('div');
    cityDiv.className = 'fc-ledger-city-str';
    cityDiv.textContent = entry.city;
    dateCol.appendChild(cityDiv);

    const slapWrap = document.createElement('div');
    slapWrap.className = 'fc-ledger-slap-wrap';
    const badge = document.createElement('span');
    if (entry.slap_on_wrist_score !== null) {
      badge.className =
        entry.slap_on_wrist_score >= 70
          ? 'fc-score-badge fc-score-badge--high'
          : 'fc-score-badge';
      badge.textContent = `SLAP ${entry.slap_on_wrist_score}`;
    } else {
      badge.className = 'fc-score-badge fc-score-badge--pending';
      badge.textContent = 'PENDING';
    }
    slapWrap.appendChild(badge);
    dateCol.appendChild(slapWrap);

    // Column 2: Body
    const body = document.createElement('div');
    body.className = 'fc-ledger-editorial-body';

    const eyebrow = document.createElement('span');
    eyebrow.className =
      entry.template === 'opinion' ? 'fc-eyebrow fc-eyebrow--opinion' : 'fc-eyebrow';
    eyebrow.textContent = entry.template === 'opinion' ? 'OPINION' : entry.agencies.join(', ');
    body.appendChild(eyebrow);

    const h2 = document.createElement('h2');
    h2.className = 'fc-ledger-editorial-headline';
    const headlineLink = document.createElement('a');
    headlineLink.href = entry.url;
    headlineLink.className = 'fc-headline-link';
    headlineLink.textContent = entry.headline;
    h2.appendChild(headlineLink);
    body.appendChild(h2);

    const deck = document.createElement('p');
    deck.className = 'fc-ledger-editorial-deck';
    deck.textContent = entry.deck;
    body.appendChild(deck);

    const stats = document.createElement('div');
    stats.className = 'fc-ledger-card-stats';

    const scaleSpan = document.createElement('span');
    scaleSpan.append('SCALE ');
    const scaleStrong = document.createElement('strong');
    scaleStrong.textContent = entry.financials.amount_display;
    scaleSpan.appendChild(scaleStrong);
    stats.appendChild(scaleSpan);

    const fineSpan = document.createElement('span');
    fineSpan.append(entry.resolved === false ? 'STATUS ' : 'FINE ');
    const fineStrong = document.createElement('strong');
    fineStrong.textContent = entry.financials.fine_display;
    fineSpan.appendChild(fineStrong);
    stats.appendChild(fineSpan);

    const ratioSpan = document.createElement('span');
    ratioSpan.append('RATIO ');
    const ratioStrong = document.createElement('strong');
    ratioStrong.style.color = 'var(--fc-art-crimson)';
    ratioStrong.textContent = entry.financials.fine_ratio_editorial;
    ratioSpan.appendChild(ratioStrong);
    stats.appendChild(ratioSpan);

    const prisonSpan = document.createElement('span');
    prisonSpan.textContent = entry.financials.prison_display;
    stats.appendChild(prisonSpan);

    body.appendChild(stats);

    // Column 3: Canvas thumbnail (<fc-painting>, zero <img>)
    const thumbLink = document.createElement('a');
    thumbLink.href = entry.url;
    thumbLink.className = 'fc-ledger-editorial-thumb';
    thumbLink.setAttribute('aria-label', entry.headline);
    thumbLink.appendChild(createThumbPainting(entry));

    article.appendChild(dateCol);
    article.appendChild(body);
    article.appendChild(thumbLink);
    return article;
  }

  function createTableRow(entry: LedgerEntry): HTMLTableRowElement {
    const tr = document.createElement('tr');
    tr.dataset.ledgerRow = '';
    tr.dataset.slug = entry.slug;

    // Case cell
    const tdCase = document.createElement('td');
    tdCase.className = 'fc-ledger-col-case';
    const link = document.createElement('a');
    link.href = entry.url;
    link.className = 'fc-headline-link fc-ledger-table-headline';
    link.textContent = entry.headline;
    tdCase.appendChild(link);

    const mobileMeta = document.createElement('span');
    mobileMeta.className = 'fc-ledger-case-mobile-meta';
    mobileMeta.textContent = `${entry.city} · ${entry.agencies[0] ?? ''}`;
    tdCase.appendChild(mobileMeta);

    const sub = document.createElement('span');
    sub.className = 'fc-ledger-table-sub';
    sub.textContent = `${entry.docket_number ?? entry.legal_stage_label} · ${entry.broadsheet_date}`;
    tdCase.appendChild(sub);
    tr.appendChild(tdCase);

    // Bureau & Agencies
    const tdBureau = document.createElement('td');
    tdBureau.className = 'fc-ledger-col-bureau';
    const cityStrong = document.createElement('strong');
    cityStrong.style.display = 'block';
    cityStrong.textContent = entry.city;
    tdBureau.appendChild(cityStrong);
    const agencySpan = document.createElement('span');
    agencySpan.style.fontSize = '11px';
    agencySpan.style.color = 'var(--fc-ink-muted)';
    agencySpan.textContent = entry.agencies.join(', ');
    tdBureau.appendChild(agencySpan);
    tr.appendChild(tdBureau);

    // Desk
    const tdDesk = document.createElement('td');
    tdDesk.className = 'fc-ledger-col-desk';
    tdDesk.textContent = entry.category;
    tr.appendChild(tdDesk);

    // Scale
    const tdScale = document.createElement('td');
    tdScale.className = 'fc-ledger-num fc-ledger-col-scale';
    const scaleStrong = document.createElement('strong');
    scaleStrong.textContent = entry.financials.amount_display;
    tdScale.appendChild(scaleStrong);
    tr.appendChild(tdScale);

    // Penalty
    const tdPenalty = document.createElement('td');
    tdPenalty.className = 'fc-ledger-num fc-ledger-col-penalty';
    tdPenalty.textContent = entry.financials.fine_display;
    tr.appendChild(tdPenalty);

    // Ratio
    const tdRatio = document.createElement('td');
    tdRatio.className = 'fc-ledger-num fc-ledger-col-ratio';
    tdRatio.style.color = 'var(--fc-art-crimson)';
    tdRatio.style.fontWeight = '600';
    tdRatio.textContent = entry.financials.fine_ratio_table;
    tr.appendChild(tdRatio);

    // Custody
    const tdCustody = document.createElement('td');
    tdCustody.className = 'fc-ledger-num fc-ledger-col-custody';
    tdCustody.textContent = entry.financials.prison_display;
    tr.appendChild(tdCustody);

    // Wrist-Slap
    const tdSlap = document.createElement('td');
    tdSlap.className = 'fc-ledger-num fc-ledger-col-slap';
    const badge = document.createElement('span');
    if (entry.slap_on_wrist_score !== null) {
      badge.className =
        entry.slap_on_wrist_score >= 70
          ? 'fc-score-badge fc-score-badge--high'
          : 'fc-score-badge';
      badge.textContent = `${entry.slap_on_wrist_score}/100`;
    } else {
      badge.className = 'fc-score-badge fc-score-badge--pending';
      badge.textContent = 'PENDING';
    }
    tdSlap.appendChild(badge);
    tr.appendChild(tdSlap);

    return tr;
  }

  function currentState(): LedgerUrlState {
    return {
      query: searchInput?.value || '',
      edition: editionSel?.value || 'all',
      category: categorySel?.value || 'all',
      minLoot: magnitudeSel?.value || '0',
      slapMode: slapSel?.value || 'all',
      sortMode: sortSel?.value || 'newest',
      view: currentView,
    };
  }

  /** Mirror the view (q, filters, sort, view, page) into the address bar for sharing/back. */
  function syncUrl(page: number) {
    try {
      const next = buildLedgerUrl(currentState(), page);
      if (`${window.location.pathname}${window.location.search}` !== next) {
        window.history.replaceState(null, '', `${next}${window.location.hash}`);
      }
    } catch {
      // Ignore history API restrictions
    }
  }

  function setPagerLink(link: HTMLAnchorElement | null, page: number | null, rel: string) {
    if (!link) return;
    if (page === null) {
      link.removeAttribute('href');
      link.removeAttribute('rel');
      link.setAttribute('aria-disabled', 'true');
    } else {
      link.href = buildLedgerUrl(currentState(), page);
      link.rel = rel;
      link.removeAttribute('aria-disabled');
    }
  }

  function updateActiveBadge() {
    if (!activeCountBadge) return;
    let activeFilters = 0;
    if ((editionSel?.value || 'all') !== 'all') activeFilters++;
    if ((categorySel?.value || 'all') !== 'all') activeFilters++;
    if ((magnitudeSel?.value || '0') !== '0') activeFilters++;
    if ((slapSel?.value || 'all') !== 'all') activeFilters++;
    if ((sortSel?.value || 'newest') !== 'newest') activeFilters++;
    activeCountBadge.hidden = activeFilters === 0;
    activeCountBadge.textContent = `${activeFilters} active`;
  }

  let applySeq = 0;

  async function applyAll(opts: { resetPage?: boolean; scrollToTop?: boolean } = {}) {
    const seq = ++applySeq;
    if (opts.resetPage) currentPage = 1;
    updateActiveBadge();

    const entries = await ensureLedgerIndex();
    if (seq !== applySeq) return;

    const q = (searchInput?.value || '').trim();
    const pfSlugs = pagefindResult && pagefindResult.q === q ? pagefindResult.slugs : null;
    const filtered = filterAndSortLedger(
      entries,
      {
        query: searchInput?.value || '',
        edition: editionSel?.value || 'all',
        category: categorySel?.value || 'all',
        minLoot: Number(magnitudeSel?.value || 0),
        slapMode: slapSel?.value || 'all',
        sortMode: sortSel?.value || 'newest',
      },
      pfSlugs
    );

    const totals = computeFilteredTotals(filtered);
    const paged = paginateItems(filtered, currentPage, pageSize);
    currentPage = paged.page;
    syncUrl(currentPage);

    if (emptyEl) emptyEl.hidden = totals.count > 0;
    if (countOut) countOut.textContent = String(totals.count);
    if (lootOut) lootOut.textContent = formatUsdShort(totals.totalLoot);
    if (finesOut) finesOut.textContent = formatUsdShort(totals.totalFines);
    if (ratioOut) ratioOut.textContent = `${totals.avgFineRatioPct.toFixed(1)}%`;

    const nextSlugs = paged.items.map((item) => item.slug);

    if (listView && !sameSlugOrder(nextSlugs, renderedListSlugs)) {
      const frag = document.createDocumentFragment();
      for (const entry of paged.items) {
        frag.appendChild(createEditorialCard(entry));
      }
      listView.replaceChildren(frag);
      renderedListSlugs = nextSlugs;
    }

    if (tbody && !sameSlugOrder(nextSlugs, renderedTableSlugs)) {
      const frag = document.createDocumentFragment();
      for (const entry of paged.items) {
        frag.appendChild(createTableRow(entry));
      }
      tbody.replaceChildren(frag);
      renderedTableSlugs = nextSlugs;
    }

    if (paginationNav) {
      paginationNav.hidden = totals.count === 0;
    }
    if (pageSummary) {
      pageSummary.textContent =
        totals.count > 0
          ? `Showing ${paged.startIndex}–${paged.endIndex} of ${paged.totalItems} filings`
          : '0 filings';
    }
    if (pageControls) {
      pageControls.hidden = paged.totalPages <= 1;
    }
    if (pageStatus) {
      pageStatus.textContent = `Page ${paged.page} of ${paged.totalPages}`;
    }
    setPagerLink(prevBtn, paged.page > 1 ? paged.page - 1 : null, 'prev');
    setPagerLink(nextBtn, paged.page < paged.totalPages ? paged.page + 1 : null, 'next');

    if (opts.scrollToTop && filterBar) {
      filterBar.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  let pfDebounce: ReturnType<typeof setTimeout> | null = null;

  async function runPagefindSearch(q: string) {
    const token = ++pagefindSeq;
    const isStale = () => token !== pagefindSeq || !searchInput || searchInput.value.trim() !== q;
    const api = await ensurePagefind();
    if (!api || isStale()) return;
    try {
      const res = await api.search(q);
      if (isStale()) return;
      const top = await Promise.all(res.results.slice(0, 50).map((r: any) => r.data()));
      // A newer keystroke may have started another search while these awaited
      if (isStale()) return;
      const slugs = new Set<string>();
      top.forEach((d: any) => {
        const m = String(d.url || '')
          .replace(/\.html$/i, '')
          .match(/\/(?:article|opinion)\/([^/]+)/);
        if (m) slugs.add(m[1]);
      });
      pagefindResult = { q, slugs };
      void applyAll({ resetPage: true });
    } catch {
      if (!isStale()) pagefindResult = null;
    }
  }

  searchInput?.addEventListener(
    'focus',
    () => {
      void ensureLedgerIndex();
      void ensurePagefind();
    },
    { once: true }
  );

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim();
    if (!q) {
      pagefindSeq++;
      pagefindResult = null;
      void applyAll({ resetPage: true });
      return;
    }
    void applyAll({ resetPage: true });
    if (pagefindUnavailable) return;
    if (pfDebounce) clearTimeout(pfDebounce);
    pfDebounce = setTimeout(() => {
      void runPagefindSearch(q);
    }, 180);
  });

  [editionSel, categorySel, magnitudeSel, slapSel, sortSel].forEach((sel) => {
    sel?.addEventListener('change', () => {
      void applyAll({ resetPage: true });
    });
  });

  // Unfiltered: let the real link load the prerendered /ledger/page/N. Filtered: page in place.
  prevBtn?.addEventListener('click', (e) => {
    if (prevBtn.getAttribute('aria-disabled') === 'true') {
      e.preventDefault();
      return;
    }
    if (!hasActiveLedgerFilters(currentState()) || currentPage <= 1) return;
    e.preventDefault();
    currentPage -= 1;
    void applyAll({ scrollToTop: true });
  });

  nextBtn?.addEventListener('click', (e) => {
    if (nextBtn.getAttribute('aria-disabled') === 'true') {
      e.preventDefault();
      return;
    }
    if (!hasActiveLedgerFilters(currentState())) return;
    e.preventDefault();
    currentPage += 1;
    void applyAll({ scrollToTop: true });
  });

  function setView(mode: 'editorial' | 'table', opts: { sync?: boolean } = {}) {
    const isTable = mode === 'table';
    currentView = mode;
    if (listView) listView.hidden = isTable;
    if (tableView) tableView.hidden = !isTable;
    btnEditorial?.setAttribute('aria-pressed', String(!isTable));
    btnTable?.setAttribute('aria-pressed', String(isTable));
    if (opts.sync) syncUrl(currentPage);
  }

  btnEditorial?.addEventListener('click', () => setView('editorial', { sync: true }));
  btnTable?.addEventListener('click', () => setView('table', { sync: true }));

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (editionSel) editionSel.value = 'all';
    if (categorySel) categorySel.value = 'all';
    if (magnitudeSel) magnitudeSel.value = '0';
    if (slapSel) slapSel.value = 'all';
    if (sortSel) sortSel.value = 'newest';
    pagefindSeq++;
    pagefindResult = null;
    void applyAll({ resetPage: true });
  });

  const params = new URLSearchParams(window.location.search);
  let hasActiveParams = false;

  if (params.get('q') && searchInput) {
    searchInput.value = params.get('q')!;
    hasActiveParams = true;
  }
  if (params.get('edition') && editionSel) {
    editionSel.value = params.get('edition')!.toLowerCase();
    hasActiveParams = true;
  }
  if (params.get('category') && categorySel) {
    const wanted = params.get('category')!;
    const opt = Array.from(categorySel.options).find(
      (o) => o.value.toLowerCase() === wanted.toLowerCase()
    );
    if (opt) {
      categorySel.value = opt.value;
      hasActiveParams = true;
    }
  }
  if (params.get('magnitude') && magnitudeSel) {
    const mag = params.get('magnitude')!;
    magnitudeSel.value = mag === '1b' ? '1000000000' : mag;
    hasActiveParams = true;
  }
  if (params.get('slap') && slapSel) {
    const s = params.get('slap')!;
    slapSel.value = s === '80' ? '70' : s;
    hasActiveParams = true;
  }
  if (params.get('sort') && sortSel) {
    sortSel.value = params.get('sort')!;
    hasActiveParams = true;
  }
  const pageParam = Number(params.get('page'));
  if (Number.isInteger(pageParam) && pageParam > 1) {
    currentPage = pageParam;
    hasActiveParams = true;
  }
  if (params.get('view') === 'table') setView('table');

  if (hasActiveParams) {
    void applyAll();
    if (params.get('q') && !pagefindUnavailable) {
      void runPagefindSearch(params.get('q')!.trim());
    }
  } else if (totalCasesInitial > pageSize) {
    // Pre-warm index in the background when pagination is active
    void ensureLedgerIndex();
  }
</script>
