---
interface Props {
  /** Latest edition date (YYYY-MM-DD) so "Today's Docket" never goes stale. */
  editionDate: string;
  /** Dynamic edition volume from content/editions/latest.json (e.g. "Vol. I, No. 1"). */
  volume?: string;
}
const { editionDate, volume } = Astro.props;
const currentYear = editionDate.slice(0, 4);
const editionHref = `/edition/${editionDate}`;
---

<footer class="fc-footer" role="contentinfo">
  <div class="fc-container">
    <div class="fc-footer-brand-row">
      <a href="/" class="fc-footer-nameplate">The Financial Crimes</a>
      <a href="/" class="fc-see-more" style="font-size: 11px;">Front Page &raquo;</a>
    </div>

    <div class="fc-footer-cols">
      <div class="fc-footer-col">
        <h3>Desks</h3>
        <ul>
          <li><a href="/ledger?category=Wall+Street">Wall Street</a></li>
          <li><a href="/ledger?category=Crypto+%26+AI">Crypto &amp; AI</a></li>
          <li><a href="/ledger?category=Courts">Courts</a></li>
          <li><a href="/ledger?category=India+%26+Asia">India &amp; Asia</a></li>
          <li><a href="/ledger?category=Europe">Europe</a></li>
          <li><a href="/ledger?category=Politics">Politics</a></li>
          <li><a href="/ledger?category=Opinion">Opinion</a></li>
        </ul>
      </div>

      <div class="fc-footer-col">
        <h3>Bureaus</h3>
        <ul>
          <li><a href="/ledger?edition=new-york">New York</a></li>
          <li><a href="/ledger?edition=us">Washington</a></li>
          <li><a href="/ledger?edition=chicago">Chicago</a></li>
          <li><a href="/ledger?edition=los-angeles">Los Angeles</a></li>
          <li><a href="/ledger?edition=london">London</a></li>
          <li><a href="/ledger?edition=india">India</a></li>
          <li><a href="/ledger?edition=europe">Europe</a></li>
          <li><a href="/ledger?edition=global">Singapore &amp; Hong Kong</a></li>
        </ul>
      </div>

      <div class="fc-footer-col">
        <h3>The Ledger</h3>
        <ul>
          <li><a href="/ledger">Full Docket</a></li>
          <li><a href="/ledger?slap=70">Highest Wrist-Slaps</a></li>
          <li><a href="/ledger?magnitude=1b">$1B+ Cases</a></li>
          <li><a href={editionHref}>Today&rsquo;s Docket</a></li>
        </ul>
      </div>

      <div class="fc-footer-col">
        <h3>Opinion</h3>
        <ul>
          <li><a href="/opinion/roger-ver-bitcoin-exit-tax-dpa">Roger Ver&rsquo;s Exit Tax</a></li>
          <li><a href="/opinion/bafin-jpmorgan-germany-record-aml-fine">JPMorgan in Frankfurt</a></li>
          <li><a href="/ledger?view=table">Spreadsheet View</a></li>
        </ul>
      </div>

      <div class="fc-footer-col">
        <h3>Reader Desk</h3>
        <ul>
          <li data-requires-js><button type="button" data-open-subscribe>Subscribe ($0)</button></li>
          <li data-requires-js><button type="button" data-open-tipline>Tip Line</button></li>
          <li data-nojs-only><a href="/rss.xml">RSS Feed</a></li>
          <li><a href="/about">About &amp; Methodology</a></li>
          <li><a href="/credits">Reference Credits</a></li>
          <li><a href="/corrections">Corrections Policy</a></li>
          <li><a href="/archive">Edition Archive</a></li>
          <li><a href="/rss.xml">RSS Feed</a></li>
        </ul>
      </div>
    </div>

    <div class="fc-footer-colophon">
      <strong>PUBLIC DOCKET &amp; FAIR REPORT NOTICE:</strong>
      <strong>The Financial Crimes</strong> is an independent digital broadsheet with
      <strong>no affiliation</strong> with <em>The New York Times</em>. Every figure, charge, and
      penalty reported here is drawn from official court filings and regulatory orders (DOJ, SEC,
      FinCEN, OCC, OFAC, SEBI, CBI, UK SFO, FCA, EPPO, BaFin, MAS, SFC, AFRC). Defendants in
      pending cases are presumed innocent until proven guilty; &ldquo;neither admit nor deny&rdquo;
      settlements are labeled as such. All oil studies are rendered procedurally in JavaScript from
      licensed public reference imagery (<a href="/credits" style="text-decoration: underline;">reference credits &amp; licenses</a>).
      See our <a href="/about" style="text-decoration: underline;">editorial standards</a> and{' '}
      <a href="/corrections" style="text-decoration: underline;">corrections log</a>.
    </div>

    <div class="fc-footer-bottom">
      <span>&copy; {currentYear} The Financial Crimes. &ldquo;All the Crimes Fit to Fine.&rdquo;</span>
      <span>{volume ? <>{volume} &middot; </> : null}Published Daily at 7:00 a.m. ET</span>
    </div>
  </div>
</footer>
