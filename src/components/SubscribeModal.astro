---
// Native <dialog> modals:
// 1. Satirical "$0/week" Paywall-That-Isn't-a-Paywall Daily Docket Signup (frontend-only Phase 1)
// 2. Public-Record Tip Line Modal
---

<dialog
  id="fc-subscribe-dialog"
  class="fc-dialog"
  aria-labelledby="fc-sub-title"
  aria-describedby="fc-sub-desc"
>
  <div class="fc-dialog-inner">
    <button
      type="button"
      class="fc-dialog-close"
      data-close-dialog
      aria-label="Close subscription dialog"
    >
      &times;
    </button>

    <p class="fc-eyebrow fc-eyebrow--crimson" style="margin: 0 0 8px;">
      METERING NOTICE · $0.00 / WEEK
    </p>
    <h2
      id="fc-sub-title"
      style="font-family: var(--fc-font-headline); font-size: 27px; font-weight: 700; line-height: 1.14; margin: 0 0 10px;"
    >
      You have reached your limit of 0 free articles.
    </h2>
    <p
      id="fc-sub-desc"
      style="font-family: var(--fc-font-body); font-size: 16px; line-height: 1.48; color: var(--fc-ink-secondary); margin: 0 0 16px;"
    >
      Just kidding. Every indictment, consent order, and fine-to-loot ratio on
      <strong>The Financial Crimes</strong> is permanently free to read — without admitting or
      denying wrongdoing. Leave your email to reserve a seat on <em>The Morning Docket</em>
      (7:00 AM ET briefing).
    </p>

    <form id="fc-subscribe-form" style="display: flex; flex-direction: column; gap: 10px;">
      <label style="display: flex; flex-direction: column; gap: 4px; font-family: var(--fc-font-sans); font-size: 12px; font-weight: 600;">
        Email Address
        <input
          type="email"
          name="email"
          required
          placeholder="counsel@example.com"
          style="border: 1px solid var(--fc-rule-strong); padding: 9px 10px; font-size: 14px; font-weight: 400;"
        />
      </label>

      <label style="display: flex; flex-direction: column; gap: 4px; font-family: var(--fc-font-sans); font-size: 12px; font-weight: 600;">
        Preferred Bureau Edition
        <select
          name="edition"
          style="border: 1px solid var(--fc-rule-medium); padding: 8px 10px; font-size: 13px; background: #fff;"
        >
          <option value="global">Global Broadsheet (All Jurisdictions)</option>
          <option value="us">U.S. Federal &amp; Wall Street</option>
          <option value="new-york">New York (SDNY / EDNY)</option>
          <option value="india">India (SEBI / CBI / ED)</option>
          <option value="london">London (UK SFO / FCA)</option>
          <option value="europe">Europe (EPPO / BaFin)</option>
        </select>
      </label>

      <button type="submit" class="fc-btn-slate" style="padding: 11px 14px; font-size: 11.5px; margin-top: 4px;">
        Subscribe for $0.00 / Week
      </button>

      <p style="font-family: var(--fc-font-sans); font-size: 11px; color: var(--fc-ink-muted); margin: 2px 0 0; line-height: 1.4;">
        Billed at $0.00 every 4 weeks forever. No deferred prosecution agreement required.
        (Preview mode: local confirmation only; newsletter delivery launches in Phase 3.)
      </p>
    </form>

    <div
      id="fc-subscribe-success"
      hidden
      style="margin-top: 14px; padding: 14px; background: var(--fc-bg-newsprint); border: 1px solid var(--fc-rule-strong); font-family: var(--fc-font-sans); font-size: 13px; line-height: 1.48;"
    >
      <strong style="display: block; margin-bottom: 4px; font-family: var(--fc-font-mono); font-size: 11.5px;">
        DOCKET RESERVATION LOGGED · $0.00 RECEIPT
      </strong>
      <span id="fc-subscribe-success-msg"></span>
    </div>
  </div>
</dialog>

<dialog
  id="fc-tipline-dialog"
  class="fc-dialog"
  aria-labelledby="fc-tip-title"
  aria-describedby="fc-tip-desc"
>
  <div class="fc-dialog-inner">
    <button
      type="button"
      class="fc-dialog-close"
      data-close-dialog
      aria-label="Close tip line dialog"
    >
      &times;
    </button>

    <p class="fc-eyebrow" style="margin: 0 0 8px;">PUBLIC RECORD DESK · TIP LINE</p>
    <h2
      id="fc-tip-title"
      style="font-family: var(--fc-font-headline); font-size: 25px; font-weight: 700; line-height: 1.15; margin: 0 0 8px;"
    >
      Flag a Public Court Filing or Consent Order
    </h2>
    <p
      id="fc-tip-desc"
      style="font-family: var(--fc-font-sans); font-size: 13px; line-height: 1.48; color: var(--fc-ink-muted); margin: 0 0 14px;"
    >
      Point our editors to an unsealed indictment, SEC/CFTC complaint, SEBI order, SFO press
      release, or regulatory fine we missed. Please submit <strong>publicly filed records</strong>
      only.
    </p>

    <form id="fc-tipline-form" style="display: flex; flex-direction: column; gap: 10px;">
      <label style="display: flex; flex-direction: column; gap: 4px; font-family: var(--fc-font-sans); font-size: 12px; font-weight: 600;">
        Jurisdiction / Agency
        <input
          type="text"
          name="agency"
          required
          placeholder="e.g., SDNY, SEC, FinCEN, SEBI, UK SFO, EPPO"
          style="border: 1px solid var(--fc-rule-medium); padding: 8px 10px; font-size: 13px;"
        />
      </label>

      <label style="display: flex; flex-direction: column; gap: 4px; font-family: var(--fc-font-sans); font-size: 12px; font-weight: 600;">
        Docket Number or Official Public URL
        <input
          type="text"
          name="docket"
          required
          placeholder="e.g., 25-Cr.-503 or https://www.justice.gov/..."
          style="border: 1px solid var(--fc-rule-medium); padding: 8px 10px; font-size: 13px;"
        />
      </label>

      <label style="display: flex; flex-direction: column; gap: 4px; font-family: var(--fc-font-sans); font-size: 12px; font-weight: 600;">
        Brief Note (What makes the ratio notable?)
        <textarea
          name="note"
          rows="3"
          required
          placeholder="Alleged amount, fine imposed, and whether executives faced personal charges..."
          style="border: 1px solid var(--fc-rule-medium); padding: 8px 10px; font-size: 13px; resize: vertical;"
        ></textarea>
      </label>

      <button type="submit" class="fc-btn-slate" style="padding: 10px 14px; font-size: 11px;">
        Submit Public Docket Tip
      </button>
    </form>

    <div
      id="fc-tipline-success"
      hidden
      style="margin-top: 14px; padding: 12px 14px; background: var(--fc-bg-newsprint); border: 1px solid var(--fc-rule-strong); font-family: var(--fc-font-sans); font-size: 13px; line-height: 1.45;"
    >
      <strong style="display: block; font-family: var(--fc-font-mono); font-size: 11px; margin-bottom: 4px;">
        TIP LOGGED FOR MORNING SWEEP REVIEW
      </strong>
      Thank you. Our editors verify every tip against primary court and agency releases before
      inclusion in the Running Ledger.
    </div>
  </div>
</dialog>

<script>
  const subForm = document.getElementById('fc-subscribe-form') as HTMLFormElement | null;
  const subSuccess = document.getElementById('fc-subscribe-success');
  const subSuccessMsg = document.getElementById('fc-subscribe-success-msg');

  if (subForm && subSuccess && subSuccessMsg) {
    subForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(subForm);
      const email = String(fd.get('email') || '').trim();
      const edition = String(fd.get('edition') || 'global');
      try {
        localStorage.setItem('fc_morning_docket_preview', JSON.stringify({ email, edition, ts: Date.now() }));
      } catch {}
      subForm.hidden = true;
      subSuccess.hidden = false;
      subSuccessMsg.textContent = `Confirmed for ${email} (${edition.toUpperCase()} desk). Your credit card has been charged exactly $0.00 — roughly the same percentage of revenue many banks pay in AML settlements.`;
    });
  }

  const tipForm = document.getElementById('fc-tipline-form') as HTMLFormElement | null;
  const tipSuccess = document.getElementById('fc-tipline-success');

  if (tipForm && tipSuccess) {
    tipForm.addEventListener('submit', (e) => {
      e.preventDefault();
      tipForm.hidden = true;
      tipSuccess.hidden = false;
    });
  }
</script>
