---
import type { ArticleRecord } from '../schemas/article';
import FcArt from './FcArt.astro';

interface Props {
  featureArticle: ArticleRecord;
  miniArticles: ArticleRecord[];
  opinionArticles: ArticleRecord[];
}

const { featureArticle, miniArticles, opinionArticles } = Astro.props;
---

<aside class="fc-right-rail" aria-label="Right Rail Features and Opinion">
  {/* TOP: Single Clean Feature Portrait */}
  <article
    class="fc-rail-spotlight"
    data-story-card
    data-edition={featureArticle.edition}
    data-city={featureArticle.city.toLowerCase()}
  >
    <div class="fc-rail-feature-art">
      <FcArt
        id={featureArticle.id}
        slug={featureArticle.slug}
        spec={featureArticle.interactive_art_spec}
        mode="inline"
        aspect="4/3"
        showChrome={false}
        showCaption={false}
      />
    </div>

    <h2 class="fc-rail-feature-title">
      <a href={featureArticle.url} class="fc-headline-link">{featureArticle.headline}</a>
    </h2>
    <p class="fc-rail-feature-deck">{featureArticle.deck}</p>
    <div class="fc-meta-row">
      <span class="fc-meta-readtime">{featureArticle.financials.amount_display}</span>
      <span class="fc-meta-readtime">{featureArticle.read_time_min} MIN READ</span>
    </div>
  </article>

  {/* MIDDLE: Native Horizontal CSS Scroll-Snap Carousel */}
  {miniArticles.length > 0 && (
    <section
      class="fc-rail-carousel"
      aria-roledescription="carousel"
      aria-label="Visual Dispatches"
      data-rail-carousel
    >
      <div class="fc-rail-carousel-track" data-carousel-track>
        {miniArticles.map((item, idx) => (
          <article
            class="fc-rail-mini-card fc-rail-slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${idx + 1} of ${miniArticles.length}`}
            data-carousel-item={idx}
            data-story-card
            data-edition={item.edition}
            data-city={item.city.toLowerCase()}
          >
            <a href={item.url} class="fc-rail-mini-art" aria-label={item.headline}>
              <FcArt
                id={`${item.id}-rail`}
                slug={item.slug}
                spec={item.interactive_art_spec}
                mode="thumb"
                aspect="1/1"
                showChrome={false}
                showCaption={false}
              />
            </a>
            <h3 class="fc-rail-mini-title">
              <a href={item.url} class="fc-headline-link">{item.headline}</a>
            </h3>
            <div class="fc-meta-row">
              <span class="fc-meta-readtime">{item.financials.amount_display}</span>
            </div>
          </article>
        ))}
      </div>

      {miniArticles.length > 1 && (
        <div class="fc-carousel-controls">
          <span class="fc-carousel-counter" data-carousel-status aria-hidden="true">
            1&ndash;{Math.min(2, miniArticles.length)} OF {miniArticles.length}
          </span>

          <div class="fc-carousel-dots" role="group" aria-label="Choose a dispatch">
            {miniArticles.map((_, idx) => (
              <button
                type="button"
                class="fc-carousel-dot"
                data-carousel-dot={idx}
                aria-label={`Go to dispatch ${idx + 1}`}
                aria-current={idx === 0 ? 'true' : undefined}
              />
            ))}
          </div>

          <div class="fc-carousel-nav-group">
            <button
              type="button"
              class="fc-carousel-btn"
              data-carousel-prev
              aria-label="Previous dispatches"
              disabled
            >
              &lsaquo;
            </button>
            <button
              type="button"
              class="fc-carousel-btn"
              data-carousel-next
              aria-label="Next dispatches"
            >
              &rsaquo;
            </button>
          </div>
        </div>
      )}

      <p class="fc-sr-only" role="status" aria-live="polite" data-carousel-live></p>
    </section>
  )}

  {/* BOTTOM: Opinion Stack */}
  {opinionArticles.length > 0 && (
    <section id="opinion-desk" aria-label="Opinion">
      <h2 class="fc-rail-opinion-heading">Opinion</h2>
      {opinionArticles.map((op, idx) => (
        <article
          class="fc-rail-opinion-item"
          data-story-card
          data-edition={op.edition}
          data-city={op.city.toLowerCase()}
        >
          <span class="fc-opinion-byline-sc">{op.byline}</span>
          <h3 class="fc-rail-opinion-title">
            <a href={op.url} class="fc-headline-link">{op.headline}</a>
          </h3>
          <div class="fc-meta-row">
            <span class="fc-meta-readtime">{op.read_time_min} MIN READ</span>
          </div>

          {idx === opinionArticles.length - 1 && (
            <a href={op.url} class="fc-rail-opinion-art" style="display: block;" aria-label={op.headline}>
              <FcArt
                id={`${op.id}-opinion-rail`}
                slug={op.slug}
                spec={{ ...op.interactive_art_spec, theme: 'monochrome' }}
                mode="thumb"
                aspect="16/10"
                showChrome={false}
                showCaption={false}
              />
            </a>
          )}
        </article>
      ))}
    </section>
  )}
</aside>

<script>
  function initRailCarousels() {
    document.querySelectorAll<HTMLElement>('[data-rail-carousel]').forEach((carousel) => {
      if (carousel.dataset.fcCarouselInit === 'true') return;
      carousel.dataset.fcCarouselInit = 'true';

      const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-item]'));
      const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
      const statusEl = carousel.querySelector<HTMLElement>('[data-carousel-status]');
      const liveEl = carousel.querySelector<HTMLElement>('[data-carousel-live]');

      if (!track || slides.length <= 1) return;

      let lastAnnouncedIndex = 0;
      let scrollTimer: number | null = null;
      let pendingIndex: number | null = null;
      let pendingTimer: number | null = null;

      function clearPending() {
        pendingIndex = null;
        if (pendingTimer !== null) {
          window.clearTimeout(pendingTimer);
          pendingTimer = null;
        }
      }

      function getLayout() {
        const trackWidth = track!.clientWidth;
        const slideWidth = slides[0]?.offsetWidth || trackWidth;
        const visibleCount =
          trackWidth > 0 && slideWidth > 0 && slideWidth <= trackWidth * 0.56 ? 2 : 1;
        const maxIndex = Math.max(0, slides.length - visibleCount);
        const maxScroll = Math.max(0, track!.scrollWidth - track!.clientWidth);
        return { visibleCount, maxIndex, maxScroll };
      }

      function getActiveIndex() {
        const { maxIndex, maxScroll } = getLayout();
        if (maxScroll <= 1) return 0;
        if (track!.scrollLeft >= maxScroll - 4) return maxIndex;

        let bestIdx = 0;
        let bestDist = Infinity;
        for (let i = 0; i <= maxIndex; i++) {
          const dist = Math.abs(slides[i].offsetLeft - track!.scrollLeft);
          if (dist < bestDist) {
            bestDist = dist;
            bestIdx = i;
          }
        }
        return bestIdx;
      }

      function syncUI(announce: boolean, overrideIndex?: number) {
        const { visibleCount, maxIndex, maxScroll } = getLayout();
        const useTarget = overrideIndex !== undefined || pendingIndex !== null;
        const activeIndex = Math.max(
          0,
          Math.min(maxIndex, overrideIndex ?? pendingIndex ?? getActiveIndex())
        );
        const atStart = useTarget ? activeIndex <= 0 : activeIndex <= 0 || track!.scrollLeft <= 2;
        const atEnd = useTarget
          ? activeIndex >= maxIndex
          : activeIndex >= maxIndex || (maxScroll > 0 && track!.scrollLeft >= maxScroll - 2);

        if (prevBtn) {
          if (atStart && document.activeElement === prevBtn && nextBtn && !atEnd) {
            nextBtn.focus();
          }
          prevBtn.disabled = atStart;
        }

        if (nextBtn) {
          if (atEnd && document.activeElement === nextBtn && prevBtn && !atStart) {
            prevBtn.focus();
          }
          nextBtn.disabled = atEnd;
        }

        dots.forEach((dot, idx) => {
          const isHidden = idx > maxIndex;
          dot.hidden = isHidden;
          if (!isHidden && idx === activeIndex) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });

        const startNum = activeIndex + 1;
        const endNum = Math.min(slides.length, activeIndex + visibleCount);
        if (statusEl) {
          statusEl.textContent =
            startNum === endNum
              ? `${startNum} OF ${slides.length}`
              : `${startNum}–${endNum} OF ${slides.length}`;
        }

        if (announce && liveEl && activeIndex !== lastAnnouncedIndex) {
          lastAnnouncedIndex = activeIndex;
          liveEl.textContent =
            startNum === endNum
              ? `Showing dispatch ${startNum} of ${slides.length}`
              : `Showing dispatches ${startNum} to ${endNum} of ${slides.length}`;
        }
      }

      function scrollToIndex(targetIdx: number) {
        const { maxIndex, maxScroll } = getLayout();
        const clamped = Math.max(0, Math.min(maxIndex, targetIdx));
        const targetLeft =
          clamped === maxIndex ? maxScroll : Math.min(slides[clamped].offsetLeft, maxScroll);

        clearPending();
        pendingIndex = clamped;
        syncUI(false, clamped);

        track!.scrollTo({ left: targetLeft, behavior: 'auto' });

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          clearPending();
          syncUI(true, clamped);
        } else {
          pendingTimer = window.setTimeout(() => {
            clearPending();
            syncUI(true);
          }, 650);
        }
      }

      prevBtn?.addEventListener('click', () => {
        const { visibleCount } = getLayout();
        const baseIndex = pendingIndex ?? getActiveIndex();
        scrollToIndex(baseIndex - visibleCount);
      });

      nextBtn?.addEventListener('click', () => {
        const { visibleCount } = getLayout();
        const baseIndex = pendingIndex ?? getActiveIndex();
        scrollToIndex(baseIndex + visibleCount);
      });

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => scrollToIndex(idx));
      });

      track.addEventListener('pointerdown', clearPending, { passive: true });
      track.addEventListener('touchstart', clearPending, { passive: true });
      track.addEventListener('wheel', clearPending, { passive: true });

      track.addEventListener('scrollend', () => {
        if (scrollTimer !== null) {
          window.clearTimeout(scrollTimer);
          scrollTimer = null;
        }
        clearPending();
        syncUI(true);
      });

      track.addEventListener(
        'scroll',
        () => {
          if (pendingIndex === null) {
            syncUI(false);
          }
          if (scrollTimer !== null) window.clearTimeout(scrollTimer);
          scrollTimer = window.setTimeout(() => {
            scrollTimer = null;
            clearPending();
            syncUI(true);
          }, 160);
        },
        { passive: true }
      );

      if (typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(() => {
          clearPending();
          syncUI(false);
        });
        ro.observe(track);
      }

      syncUI(false);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRailCarousels);
  } else {
    initRailCarousels();
  }
</script>
