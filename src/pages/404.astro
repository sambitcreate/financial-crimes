---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactHeader from '../components/CompactHeader.astro';
---

<BaseLayout
  title="404 — File Shredded | The Financial Crimes"
  description="The requested docket page could not be found."
  noindex
>
  <CompactHeader slot="header" showTopicBar={false} />

  <section
    class="fc-container"
    style="padding-top: 64px; padding-bottom: 84px; max-width: 660px; text-align: center;"
  >
    <div
      style="display: inline-block; border: 2px solid var(--fc-art-crimson); color: var(--fc-art-crimson); font-family: var(--fc-font-mono); font-size: 11.5px; font-weight: 700; letter-spacing: 0.14em; padding: 5px 12px; margin-bottom: 20px; text-transform: uppercase;"
    >
      EXHIBIT 404 &middot; DOCUMENT RETENTION
    </div>

    <h1
      style="font-family: var(--fc-font-headline); font-size: clamp(32px, 5vw, 46px); font-weight: 700; font-style: italic; line-height: 1.1; margin: 0 0 16px;"
    >
      This Case File Was Shredded
    </h1>

    <p
      style="font-family: var(--fc-font-body); font-size: 18.5px; line-height: 1.52; color: var(--fc-ink-secondary); margin: 0 auto 24px; max-width: 520px;"
    >
      Our servers cannot locate this page &mdash; without admitting or denying that it ever existed.
    </p>

    <div
      style="background: var(--fc-bg-newsprint); border: 1px solid var(--fc-rule-strong); padding: 14px 18px; margin: 0 auto 28px; max-width: 440px; font-family: var(--fc-font-mono); font-size: 12px; text-align: left;"
    >
      <div class="fc-receipt-row">
        <span class="fc-receipt-row-label">STATUS</span>
        <strong>404 NOT FOUND</strong>
      </div>
      <div class="fc-receipt-row">
        <span class="fc-receipt-row-label">PENALTY</span>
        <strong>$0.00</strong>
      </div>
      <div class="fc-receipt-row" style="margin-bottom: 0;">
        <span class="fc-receipt-row-label">CUSTODY</span>
        <strong>0 DAYS</strong>
      </div>
    </div>

    <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 10px;">
      <a href="/" class="fc-btn-slate" style="padding: 10px 16px; font-size: 11.5px;">
        Front Page
      </a>
      <a href="/ledger" class="fc-btn-outline" style="padding: 9px 16px; font-size: 12px;">
        The Ledger
      </a>
    </div>
  </section>
</BaseLayout>
