---
/**
 * Prerendered ledger pages 2..N (/ledger/page/2 …) so pagination works without JavaScript.
 * Page 1 lives at /ledger.
 */
import LedgerPage from '../../../components/LedgerPage.astro';
import { loadAllArticles } from '../../../loaders/articles';
import { LEDGER_PAGE_SIZE, listedArticles } from '../../../utils/ledger';

export async function getStaticPaths() {
  const articles = listedArticles(await loadAllArticles());
  const totalPages = Math.max(1, Math.ceil(articles.length / LEDGER_PAGE_SIZE));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2 },
  }));
}

interface Props {
  page: number;
}

const { page } = Astro.props;
---

<LedgerPage page={page} />
