---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactHeader from '../components/CompactHeader.astro';
import FcArt from '../components/FcArt.astro';
import { loadAllArticles, loadRollupStats } from '../loaders/articles';
import {
  formatBroadsheetDate,
  formatFineRatio,
  formatLegalStage,
  formatShortDate,
} from '../utils/format';

const [articles, rollup] = await Promise.all([loadAllArticles(), loadRollupStats()]);

const categories = Array.from(new Set(articles.map((a) => a.category))).sort();
const editions = [
  { key: 'all', label: 'All Bureaus' },
  { key: 'us', label: 'U.S.' },
  { key: 'new-york', label: 'New York' },
  { key: 'chicago', label: 'Chicago' },
  { key: 'los-angeles', label: 'Los Angeles' },
  { key: 'london', label: 'London' },
  { key: 'india', label: 'India' },
  { key: 'europe', label: 'Europe' },
  { key: 'global', label: 'Singapore & HK' },
];

const topicLinks = [
  { label: 'Front Page', href: '/' },
  { label: 'Full Ledger', href: '/ledger', current: true },
  { label: '$1B+ Cases', href: '/ledger?magnitude=1000000000' },
  { label: 'Zero Prison', href: '/ledger?slap=zero-prison' },
  { label: "Today's Docket", href: `/edition/${rollup.edition_date}` },
];
---

<BaseLayout
  title="The Ledger — The Financial Crimes"
  description="Searchable ledger of global white-collar crime, fines, fine-to-loot ratios, and prison sentences."
>
  <CompactHeader
    slot="header"
    showTopicBar={true}
    topicTitle="The Ledger"
    topicLinks={topicLinks}
  />

  <div class="fc-container" style="padding-bottom: 56px;">
    {/* Ledger Hero Header */}
    <header class="fc-ledger-hero">
      <h1 class="fc-ledger-title" style="margin-top: 0;">The Running Ledger</h1>
      <p style="font-family: var(--fc-font-body); font-size: 16.5px; color: var(--fc-ink-muted); max-width: 640px; margin: 0;">
        Every indictment, consent order, fine-to-loot ratio, and prison sentence on our docket.
      </p>

      {/* Live Dynamic Totals Strip */}
      <div class="fc-ledger-totals" aria-live="polite">
        <div>
          <span class="fc-docket-stat-label">Cases</span>
          <span class="fc-docket-stat-val" id="fc-ledger-total-count" style="font-size: 18px;">
            {articles.length}
          </span>
        </div>
        <div>
          <span class="fc-docket-stat-label">Alleged Scale</span>
          <span class="fc-docket-stat-val" id="fc-ledger-total-loot" style="font-size: 18px;">
            {rollup.total_loot_display}
          </span>
        </div>
        <div>
          <span class="fc-docket-stat-label">Penalties</span>
          <span class="fc-docket-stat-val" id="fc-ledger-total-fines" style="font-size: 18px;">
            {rollup.total_fines_display}
          </span>
        </div>
        <div>
          <span class="fc-docket-stat-label">Avg. Fine / Loot</span>
          <span
            class="fc-docket-stat-val"
            id="fc-ledger-avg-ratio"
            style="font-size: 18px; color: var(--fc-art-crimson);"
          >
            {rollup.avg_fine_ratio_pct.toFixed(1)}%
          </span>
        </div>
      </div>
    </header>

    {/* Multi-Facet Filter Bar (sticky on desktop, static + collapsible drawer on mobile) */}
    <section class="fc-ledger-filterbar" aria-label="Filter and sort the Ledger">
      <div class="fc-ledger-controls">
        <div class="fc-ledger-primary-row">
          <label class="fc-sr-only" for="fc-ledger-search">Search cases</label>
          <input
            type="search"
            id="fc-ledger-search"
            placeholder="Search cases, agencies..."
          />

          <div class="fc-view-toggle" role="group" aria-label="Ledger display mode">
            <button type="button" id="fc-view-editorial" aria-pressed="true">Editorial</button>
            <button type="button" id="fc-view-table" aria-pressed="false">Table</button>
          </div>
        </div>

        <details class="fc-ledger-mobile-drawer" id="fc-ledger-filter-drawer" open>
          <summary class="fc-ledger-drawer-summary">
            <span class="fc-ledger-drawer-summary-left">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M2 3.5h12M4.5 8h7M6.5 12.5h3"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                />
              </svg>
              <span>Filters &amp; Sort</span>
              <span class="fc-ledger-active-badge" id="fc-ledger-active-count" hidden>0</span>
            </span>
            <svg
              class="fc-ledger-drawer-chevron"
              width="12"
              height="12"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2.5 4.25L6 7.75L9.5 4.25"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
              />
            </svg>
          </summary>

          <div class="fc-ledger-drawer-grid">
            <label class="fc-sr-only" for="fc-ledger-edition">Bureau</label>
            <select id="fc-ledger-edition">
              {editions.map((ed) => (
                <option value={ed.key}>{ed.label}</option>
              ))}
            </select>

            <label class="fc-sr-only" for="fc-ledger-category">Category</label>
            <select id="fc-ledger-category">
              <option value="all">All Desks</option>
              {categories.map((cat) => (
                <option value={cat}>{cat}</option>
              ))}
            </select>

            <label class="fc-sr-only" for="fc-ledger-magnitude">Scale</label>
            <select id="fc-ledger-magnitude">
              <option value="0">Any Scale</option>
              <option value="10000000">$10M+</option>
              <option value="100000000">$100M+</option>
              <option value="500000000">$500M+</option>
              <option value="1000000000">$1B+</option>
            </select>

            <label class="fc-sr-only" for="fc-ledger-slap">Outcome</label>
            <select id="fc-ledger-slap">
              <option value="all">All Outcomes</option>
              <option value="70">Wrist-Slap &ge; 70</option>
              <option value="85">Wrist-Slap &ge; 85</option>
              <option value="zero-prison">Zero Prison</option>
              <option value="pending">Pending</option>
            </select>

            <label class="fc-sr-only" for="fc-ledger-sort">Sort order</label>
            <select id="fc-ledger-sort" class="fc-ledger-select-sort">
              <option value="newest">Sort: Newest</option>
              <option value="loot-desc">Sort: Largest Scale</option>
              <option value="fine-desc">Sort: Largest Fine</option>
              <option value="slap-desc">Sort: Highest Wrist-Slap</option>
              <option value="ratio-asc">Sort: Lowest Fine Ratio</option>
            </select>
          </div>
        </details>
        <script is:inline>
          (function () {
            var drawer = document.getElementById('fc-ledger-filter-drawer');
            if (drawer && window.matchMedia && window.matchMedia('(max-width: 760px)').matches) {
              drawer.open = false;
            }
          })();
        </script>
      </div>
    </section>

    {/* Empty State */}
    <div
      id="fc-ledger-empty"
      hidden
      style="padding: 40px 20px; text-align: center; border-bottom: 1px solid var(--fc-rule-column);"
    >
      <p style="font-family: var(--fc-font-headline); font-size: 21px; margin: 0 0 10px;">
        No filings match those filters.
      </p>
      <button type="button" class="fc-btn-outline" id="fc-ledger-reset-btn">
        Reset Filters
      </button>
    </div>

    {/* VIEW 1: Editorial List with Crisp Formatted Dates & Mini-Canvas Portraits */}
    <section id="fc-ledger-list-view" class="fc-ledger-editorial-list" aria-label="Case list">
      {articles.map((item) => {
        const searchBlob = [
          item.headline,
          item.deck,
          item.city,
          item.edition,
          item.category,
          item.agencies.join(' '),
          item.docket_number ?? '',
          item.jurisdiction.venue,
          item.byline,
        ]
          .join(' ')
          .toLowerCase();

        return (
          <article
            class="fc-ledger-editorial-row"
            data-ledger-item
            data-slug={item.slug}
            data-search={searchBlob}
            data-edition={item.edition.toLowerCase()}
            data-city={item.city.toLowerCase()}
            data-category={item.category}
            data-date={item.publish_date}
            data-loot={item.financials.amount_usd ?? 0}
            data-fine={item.financials.fine_usd ?? 0}
            data-ratio={item.financials.fine_ratio_pct ?? -1}
            data-prison={item.financials.prison_months ?? -1}
            data-slap={item.slap_on_wrist_score ?? -1}
          >
            <div class="fc-ledger-date-col">
              <span class="fc-ledger-date-str">{formatShortDate(item.publish_date)}</span>
              <div class="fc-ledger-city-str">{item.city}</div>
              <div class="fc-ledger-slap-wrap">
                {item.slap_on_wrist_score !== null ? (
                  <span
                    class:list={[
                      'fc-score-badge',
                      { 'fc-score-badge--high': item.slap_on_wrist_score >= 70 },
                    ]}
                  >
                    SLAP {item.slap_on_wrist_score}
                  </span>
                ) : (
                  <span class="fc-score-badge fc-score-badge--pending">PENDING</span>
                )}
              </div>
            </div>

            <div class="fc-ledger-editorial-body">
              <span
                class:list={[
                  'fc-eyebrow',
                  { 'fc-eyebrow--opinion': item.template === 'opinion' },
                ]}
              >
                {item.template === 'opinion' ? 'OPINION' : item.agencies.join(', ')}
              </span>

              <h2 class="fc-ledger-editorial-headline">
                <a href={item.url} class="fc-headline-link">{item.headline}</a>
              </h2>

              <p class="fc-ledger-editorial-deck">{item.deck}</p>

              <div class="fc-ledger-card-stats">
                <span>SCALE <strong>{item.financials.amount_display}</strong></span>
                <span>FINE <strong>{item.financials.fine_display}</strong></span>
                <span>
                  RATIO{' '}
                  <strong style="color: var(--fc-art-crimson);">
                    {formatFineRatio(item.financials.fine_ratio_pct, 'Pending')}
                  </strong>
                </span>
                <span>{item.financials.prison_display}</span>
              </div>
            </div>

            <a href={item.url} class="fc-ledger-editorial-thumb" aria-label={item.headline}>
              <FcArt
                id={`${item.id}-ledger`}
                slug={item.slug}
                spec={item.interactive_art_spec}
                mode="thumb"
                aspect="16/10"
                showCaption={false}
              />
            </a>
          </article>
        );
      })}
    </section>

    {/* VIEW 2: Spreadsheet Table */}
    <section id="fc-ledger-table-view" class="fc-ledger-table-wrap" hidden aria-label="Spreadsheet ledger">
      <div class="fc-ledger-table-cue" aria-hidden="true">
        <span class="fc-ledger-table-cue-pin">Case pinned</span>
        <span class="fc-ledger-table-cue-swipe">Swipe table &rarr;</span>
      </div>
      <div class="fc-ledger-table-scroller">
        <table class="fc-ledger-table">
          <thead>
            <tr>
              <th class="fc-ledger-col-case">Case</th>
              <th class="fc-ledger-col-bureau">Bureau &amp; Agencies</th>
              <th class="fc-ledger-col-desk">Desk</th>
              <th class="fc-ledger-col-scale">Scale</th>
              <th class="fc-ledger-col-penalty">Penalty</th>
              <th class="fc-ledger-col-ratio">Ratio</th>
              <th class="fc-ledger-col-custody">Custody</th>
              <th class="fc-ledger-col-slap">Wrist-Slap</th>
            </tr>
          </thead>
          <tbody id="fc-ledger-tbody">
            {articles.map((item) => {
              const searchBlob = [
                item.headline,
                item.deck,
                item.city,
                item.edition,
                item.category,
                item.agencies.join(' '),
                item.docket_number ?? '',
                item.jurisdiction.venue,
              ]
                .join(' ')
                .toLowerCase();

              return (
                <tr
                  data-ledger-row
                  data-slug={item.slug}
                  data-search={searchBlob}
                  data-edition={item.edition.toLowerCase()}
                  data-city={item.city.toLowerCase()}
                  data-category={item.category}
                  data-date={item.publish_date}
                  data-loot={item.financials.amount_usd ?? 0}
                  data-fine={item.financials.fine_usd ?? 0}
                  data-ratio={item.financials.fine_ratio_pct ?? -1}
                  data-prison={item.financials.prison_months ?? -1}
                  data-slap={item.slap_on_wrist_score ?? -1}
                >
                  <td class="fc-ledger-col-case">
                    <a
                      href={item.url}
                      class="fc-headline-link fc-ledger-table-headline"
                    >
                      {item.headline}
                    </a>
                    <span class="fc-ledger-case-mobile-meta">
                      {item.city} &middot; {item.agencies[0]}
                    </span>
                    <span class="fc-ledger-table-sub">
                      {item.docket_number ?? formatLegalStage(item.legal_stage)} &middot; {formatBroadsheetDate(item.publish_date)}
                    </span>
                  </td>
                  <td class="fc-ledger-col-bureau">
                    <strong style="display: block;">{item.city}</strong>
                    <span style="font-size: 11px; color: var(--fc-ink-muted);">
                      {item.agencies.join(', ')}
                    </span>
                  </td>
                  <td class="fc-ledger-col-desk">{item.category}</td>
                  <td class="fc-ledger-num fc-ledger-col-scale"><strong>{item.financials.amount_display}</strong></td>
                  <td class="fc-ledger-num fc-ledger-col-penalty">{item.financials.fine_display}</td>
                  <td class="fc-ledger-num fc-ledger-col-ratio" style="color: var(--fc-art-crimson); font-weight: 600;">
                    {formatFineRatio(item.financials.fine_ratio_pct, '—')}
                  </td>
                  <td class="fc-ledger-num fc-ledger-col-custody">{item.financials.prison_display}</td>
                  <td class="fc-ledger-num fc-ledger-col-slap">
                    {item.slap_on_wrist_score !== null ? (
                      <span
                        class:list={[
                          'fc-score-badge',
                          { 'fc-score-badge--high': item.slap_on_wrist_score >= 70 },
                        ]}
                      >
                        {item.slap_on_wrist_score}/100
                      </span>
                    ) : (
                      <span class="fc-score-badge fc-score-badge--pending">PENDING</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { formatUsdShort } from '../utils/format';
  const searchInput = document.getElementById('fc-ledger-search') as HTMLInputElement | null;
  const editionSel = document.getElementById('fc-ledger-edition') as HTMLSelectElement | null;
  const categorySel = document.getElementById('fc-ledger-category') as HTMLSelectElement | null;
  const magnitudeSel = document.getElementById('fc-ledger-magnitude') as HTMLSelectElement | null;
  const slapSel = document.getElementById('fc-ledger-slap') as HTMLSelectElement | null;
  const sortSel = document.getElementById('fc-ledger-sort') as HTMLSelectElement | null;

  const listView = document.getElementById('fc-ledger-list-view');
  const tableView = document.getElementById('fc-ledger-table-view');
  const tbody = document.getElementById('fc-ledger-tbody');
  const emptyEl = document.getElementById('fc-ledger-empty');
  const resetBtn = document.getElementById('fc-ledger-reset-btn');

  const btnEditorial = document.getElementById('fc-view-editorial');
  const btnTable = document.getElementById('fc-view-table');
  const filterDrawer = document.getElementById('fc-ledger-filter-drawer') as HTMLDetailsElement | null;
  const activeCountBadge = document.getElementById('fc-ledger-active-count');

  const countOut = document.getElementById('fc-ledger-total-count');
  const lootOut = document.getElementById('fc-ledger-total-loot');
  const finesOut = document.getElementById('fc-ledger-total-fines');
  const ratioOut = document.getElementById('fc-ledger-avg-ratio');

  const listItems = Array.from(document.querySelectorAll<HTMLElement>('[data-ledger-item]'));
  const tableRows = Array.from(document.querySelectorAll<HTMLElement>('[data-ledger-row]'));

  // Sync collapsible filter drawer across viewport breakpoint changes
  if (filterDrawer && window.matchMedia) {
    const mobileMq = window.matchMedia('(max-width: 760px)');
    const syncDrawerForViewport = (matchesMobile: boolean) => {
      filterDrawer.open = !matchesMobile;
    };
    syncDrawerForViewport(mobileMq.matches);
    mobileMq.addEventListener('change', (e) => syncDrawerForViewport(e.matches));
  }

  let pagefindApi: any = null;
  let pagefindSlugs: Set<string> | null = null;
  let pagefindPromise: Promise<any> | null = null;
  let pagefindUnavailable = Boolean(import.meta.env.DEV);

  async function ensurePagefind() {
    if (pagefindApi) return pagefindApi;
    if (pagefindUnavailable) return null;
    if (!pagefindPromise) {
      pagefindPromise = (async () => {
        try {
          const pfPath = '/pagefind/pagefind.js';
          const mod = await import(/* @vite-ignore */ pfPath);
          if (mod?.init) await mod.init();
          pagefindApi = mod;
          return mod;
        } catch {
          pagefindUnavailable = true;
          pagefindApi = null;
          return null;
        }
      })();
    }
    return pagefindPromise;
  }

  function matchesEdition(el: HTMLElement, key: string): boolean {
    if (key === 'all') return true;
    const ed = el.dataset.edition || '';
    const city = el.dataset.city || '';
    if (key === 'us') return ['us', 'new-york', 'chicago', 'los-angeles'].includes(ed);
    if (key === 'europe') return ed === 'europe' || ed === 'london' || city.includes('frankfurt');
    if (key === 'global') return ed === 'global' || city.includes('singapore') || city.includes('hong kong');
    return ed === key || city.includes(key.replace('-', ' '));
  }

  function matchesFilters(el: HTMLElement): boolean {
    const q = (searchInput?.value || '').trim().toLowerCase();
    const ed = editionSel?.value || 'all';
    const cat = categorySel?.value || 'all';
    const minLoot = Number(magnitudeSel?.value || 0);
    const slapMode = slapSel?.value || 'all';

    if (q) {
      const slug = el.dataset.slug || '';
      const localMatch = (el.dataset.search || '').includes(q);
      const pfMatch = pagefindSlugs ? pagefindSlugs.has(slug) : false;
      if (!localMatch && !pfMatch) return false;
    }

    if (!matchesEdition(el, ed)) return false;
    if (cat !== 'all' && el.dataset.category !== cat) return false;

    const loot = Number(el.dataset.loot || 0);
    if (minLoot > 0 && loot < minLoot) return false;

    const slap = Number(el.dataset.slap ?? -1);
    const prison = Number(el.dataset.prison ?? -1);
    if (slapMode === '70' && slap < 70) return false;
    if (slapMode === '85' && slap < 85) return false;
    if (slapMode === 'zero-prison' && prison !== 0) return false;
    if (slapMode === 'pending' && slap >= 0) return false;

    return true;
  }

  function compareElements(a: HTMLElement, b: HTMLElement, mode: string): number {
    if (mode === 'loot-desc') return Number(b.dataset.loot || 0) - Number(a.dataset.loot || 0);
    if (mode === 'fine-desc') return Number(b.dataset.fine || 0) - Number(a.dataset.fine || 0);
    if (mode === 'slap-desc') return Number(b.dataset.slap || -1) - Number(a.dataset.slap || -1);
    if (mode === 'ratio-asc') {
      const ra = Number(a.dataset.ratio ?? -1);
      const rb = Number(b.dataset.ratio ?? -1);
      const va = ra < 0 ? 999999 : ra;
      const vb = rb < 0 ? 999999 : rb;
      return va - vb;
    }
    return (Date.parse(b.dataset.date || '') || 0) - (Date.parse(a.dataset.date || '') || 0);
  }

  // Moving a node re-runs <fc-painting> disconnect/connect, which repaints it from blank,
  // so only touch the DOM order when the sort actually changed it.
  let currentListOrder: HTMLElement[] = [...listItems];
  let currentRowOrder: HTMLElement[] = [...tableRows];
  function sameOrder(a: HTMLElement[], b: HTMLElement[]): boolean {
    return a.length === b.length && a.every((el, i) => el === b[i]);
  }

  function applyAll() {
    const sortMode = sortSel?.value || 'newest';

    const sortedList = [...listItems].sort((a, b) => compareElements(a, b, sortMode));
    const sortedRows = [...tableRows].sort((a, b) => compareElements(a, b, sortMode));

    let shown = 0;
    let totalLoot = 0;
    let totalFines = 0;
    let ratioSum = 0;
    let ratioCount = 0;

    const reorderList = !sameOrder(sortedList, currentListOrder);
    const reorderRows = !sameOrder(sortedRows, currentRowOrder);
    currentListOrder = sortedList;
    currentRowOrder = sortedRows;

    sortedList.forEach((el) => {
      const visible = matchesFilters(el);
      el.hidden = !visible;
      if (reorderList) listView?.appendChild(el);
      if (visible) {
        shown++;
        totalLoot += Number(el.dataset.loot || 0);
        totalFines += Number(el.dataset.fine || 0);
        const r = Number(el.dataset.ratio ?? -1);
        if (r >= 0) {
          ratioSum += r;
          ratioCount++;
        }
      }
    });

    sortedRows.forEach((row) => {
      row.hidden = !matchesFilters(row);
      if (reorderRows) tbody?.appendChild(row);
    });

    if (emptyEl) emptyEl.hidden = shown > 0;
    if (countOut) countOut.textContent = String(shown);
    if (lootOut) lootOut.textContent = formatUsdShort(totalLoot);
    if (finesOut) finesOut.textContent = formatUsdShort(totalFines);
    if (ratioOut) {
      const aggregateRatio = totalLoot > 0 ? (totalFines / totalLoot) * 100 : ratioCount > 0 ? ratioSum / ratioCount : 0;
      ratioOut.textContent = `${aggregateRatio.toFixed(1)}%`;
    }

    if (activeCountBadge) {
      let activeFilters = 0;
      if ((editionSel?.value || 'all') !== 'all') activeFilters++;
      if ((categorySel?.value || 'all') !== 'all') activeFilters++;
      if ((magnitudeSel?.value || '0') !== '0') activeFilters++;
      if ((slapSel?.value || 'all') !== 'all') activeFilters++;
      if ((sortSel?.value || 'newest') !== 'newest') activeFilters++;
      activeCountBadge.hidden = activeFilters === 0;
      activeCountBadge.textContent = `${activeFilters} active`;
    }
  }

  let pfDebounce: ReturnType<typeof setTimeout> | null = null;

  async function runPagefindSearch(q: string) {
    const api = await ensurePagefind();
    if (!api || !searchInput || searchInput.value.trim() !== q) return;
    try {
      const res = await api.search(q);
      const top = await Promise.all(res.results.slice(0, 30).map((r: any) => r.data()));
      const slugs = new Set<string>();
      top.forEach((d: any) => {
        const m = String(d.url || '').match(/\/(?:article|opinion)\/([^/]+)/);
        if (m) slugs.add(m[1]);
      });
      pagefindSlugs = slugs;
      applyAll();
    } catch {
      pagefindSlugs = null;
    }
  }

  searchInput?.addEventListener(
    'focus',
    () => {
      void ensurePagefind();
    },
    { once: true }
  );

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim();
    if (!q) {
      pagefindSlugs = null;
      applyAll();
      return;
    }
    applyAll();
    if (pagefindUnavailable) return;
    if (pfDebounce) clearTimeout(pfDebounce);
    pfDebounce = setTimeout(() => {
      void runPagefindSearch(q);
    }, 180);
  });

  [editionSel, categorySel, magnitudeSel, slapSel, sortSel].forEach((sel) => {
    sel?.addEventListener('change', applyAll);
  });

  function setView(mode: 'editorial' | 'table') {
    const isTable = mode === 'table';
    if (listView) listView.hidden = isTable;
    if (tableView) tableView.hidden = !isTable;
    btnEditorial?.setAttribute('aria-pressed', String(!isTable));
    btnTable?.setAttribute('aria-pressed', String(isTable));
  }

  btnEditorial?.addEventListener('click', () => setView('editorial'));
  btnTable?.addEventListener('click', () => setView('table'));

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (editionSel) editionSel.value = 'all';
    if (categorySel) categorySel.value = 'all';
    if (magnitudeSel) magnitudeSel.value = '0';
    if (slapSel) slapSel.value = 'all';
    if (sortSel) sortSel.value = 'newest';
    pagefindSlugs = null;
    applyAll();
  });

  const params = new URLSearchParams(window.location.search);
  if (params.get('q') && searchInput) searchInput.value = params.get('q')!;
  if (params.get('edition') && editionSel) editionSel.value = params.get('edition')!.toLowerCase();
  if (params.get('category') && categorySel) {
    const wanted = params.get('category')!;
    const opt = Array.from(categorySel.options).find(
      (o) => o.value.toLowerCase() === wanted.toLowerCase()
    );
    if (opt) categorySel.value = opt.value;
  }
  if (params.get('magnitude') && magnitudeSel) {
    const mag = params.get('magnitude')!;
    magnitudeSel.value = mag === '1b' ? '1000000000' : mag;
  }
  if (params.get('slap') && slapSel) {
    const s = params.get('slap')!;
    slapSel.value = s === '80' ? '70' : s;
  }
  if (params.get('view') === 'table') setView('table');

  applyAll();
  if (params.get('q') && !pagefindUnavailable) {
    void runPagefindSearch(params.get('q')!.trim());
  }
</script>
