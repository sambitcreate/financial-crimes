---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactHeader from '../components/CompactHeader.astro';
import { loadAllArticles } from '../loaders/articles';
import { getPaintRefLookup } from '../painting/refs-loader';
import { buildCreditEntries, summarizeLicenses } from '../utils/ledger';

const [articles, { manifest }] = await Promise.all([loadAllArticles(), getPaintRefLookup()]);
const creditRows = buildCreditEntries(articles, manifest);
const licenseSummary = summarizeLicenses(creditRows);

const topicLinks = [
  { label: 'Front Page', href: '/' },
  { label: 'About & Methodology', href: '/about', current: true },
  { label: 'Reference Credits', href: '/credits' },
  { label: 'Corrections', href: '/corrections' },
  { label: 'The Ledger', href: '/ledger' },
];
---

<BaseLayout
  title="About & Methodology — The Financial Crimes"
  description="Editorial mission, hard fact/satire firewall, Slap-on-the-Wrist scoring rubric, Fair Report Privilege standards, and Creative Commons portrait attributions."
  canonicalPath="/about"
>
  <CompactHeader
    slot="header"
    showTopicBar={true}
    topicTitle="About"
    topicLinks={topicLinks}
  />

  <article class="fc-trust-page">
    <header class="fc-trust-header">
      <p class="fc-eyebrow fc-eyebrow--crimson" style="margin: 0;">
        NEWSROOM STANDARDS &amp; METHODOLOGY
      </p>
      <h1 class="fc-trust-h1">About The Financial Crimes</h1>
      <p class="fc-trust-deck">
        &ldquo;All the Crimes Fit to Fine.&rdquo; An independent daily digital broadsheet tracking
        global white-collar crime, corporate enforcement penalties, and prison sentences strictly
        from primary court dockets and regulatory orders.
      </p>
    </header>

    <section class="fc-trust-section" id="mission">
      <h2 class="fc-trust-h2">Editorial Mission</h2>
      <div class="fc-trust-prose">
        <p>
          <strong>The Financial Crimes</strong> exists to keep a permanent, searchable public ledger
          of white-collar, corporate, and regulatory enforcement across major financial jurisdictions
          &mdash; including New York, Washington, Chicago, Los Angeles, London, Frankfurt, Mumbai,
          New Delhi, Singapore, and Hong Kong.
        </p>
        <p>
          Every dispatch pairs the alleged or adjudicated scale of a scheme directly against the
          civil penalty, disgorgement, criminal fine, and actual custody imposed. All coverage,
          tables, and RSS feeds are permanently free ($0.00 / no paywall).
        </p>
      </div>
    </section>

    <section class="fc-trust-section" id="fact-satire-wall">
      <h2 class="fc-trust-h2">The Hard Fact / Satire Wall</h2>
      <div class="fc-trust-prose">
        <p>
          Our voice draws on dry broadsheet irony, but we enforce an absolute firewall between
          <strong>factual reporting</strong> and <strong>editorial framing</strong>:
        </p>
        <div class="fc-trust-callout">
          <strong>Facts are sacred; framing carries the wit.</strong> Every dollar amount, fine
          ratio, prison sentence, agency citation, docket number, defendant name, and legal stage
          is verified against official court records or government enforcement releases (DOJ, SEC,
          FinCEN, OCC, OFAC, SEBI, CBI, UK SFO, FCA, EPPO, BaFin, MAS, SFC, AFRC). We never invent
          quotes, fabricate figures, or blur unproven allegations into convictions.
        </div>
        <p>
          Opinion essays are visually separated under the <strong>OPINION</strong> label and
          monochrome artwork. News dispatches stick strictly to documented filings.
        </p>
      </div>
    </section>

    <section class="fc-trust-section" id="rubric">
      <h2 class="fc-trust-h2">Slap-on-the-Wrist Scoring Rubric</h2>
      <div class="fc-trust-prose">
        <p>
          Each concluded enforcement action receives a <strong>Slap-on-the-Wrist Score (0&ndash;100)</strong>
          evaluating how lightly a corporate or executive penalty lands relative to the documented
          scale of misconduct, custody outcomes, and admissions of guilt.
        </p>
        <p>
          <strong>Pending Cases Are Never Scored:</strong> Active indictments, arrests, interim
          orders, and pre-sentencing verdicts always display <code>PENDING</code> (<code>null</code>)
          until a final settlement, regulatory order, deferred prosecution agreement (DPA), or
          sentence is entered.
        </p>

        <div class="fc-trust-rubric-grid">
          <div class="fc-trust-rubric-card">
            <span class="fc-trust-rubric-band">0 &ndash; 29 &middot; SUBSTANTIAL</span>
            Significant multi-year prison sentences, meaningful forfeiture or restitution relative
            to loss, or explicit guilty pleas / convictions.
          </div>
          <div class="fc-trust-rubric-card">
            <span class="fc-trust-rubric-band">30 &ndash; 69 &middot; MIXED</span>
            Large monetary penalties or partial executive sanctions, tempered by limited personal
            custody, negotiated discounts, or stayed relief.
          </div>
          <div class="fc-trust-rubric-card">
            <span class="fc-trust-rubric-band fc-trust-rubric-band--high">70 &ndash; 100 &middot; WRIST-SLAP</span>
            Pennies-on-the-dollar fine-to-scale ratios, zero executives charged or jailed,
            &ldquo;neither admit nor deny&rdquo; language, or repeat-offender DPA discounts.
          </div>
        </div>

        <p>
          <strong>Site-Wide Fine-to-Loot Ratio:</strong> All aggregate tickers and regional rollups
          compute the sum of imposed penalties divided by the sum of documented case scale
          (<code>sum(fines) / sum(scale)</code>) across included dockets, so front-page, drawer, and
          ledger figures always agree.
        </p>
      </div>
    </section>

    <section class="fc-trust-section" id="fair-report">
      <h2 class="fc-trust-h2">Fair Report Privilege &amp; Presumption of Innocence</h2>
      <div class="fc-trust-prose">
        <p>
          Our reporting relies on the <strong>Fair Report Privilege</strong> &mdash; summarizing
          official judicial and regulatory filings accurately, neutrally, and with direct hyperlinks
          to primary public records at the foot of every story.
        </p>
        <p>
          Defendants named in indictments, criminal complaints, civil enforcement actions, or
          interim administrative orders are <strong>presumed innocent until proven guilty</strong>
          in a court of law. Settlements entered on a &ldquo;neither admit nor deny&rdquo; basis
          are explicitly labeled as such. If a case is dismissed, reversed on appeal, or ends in
          acquittal, we update the docket promptly under our{' '}
          <a href="/corrections">Corrections &amp; Update Protocol</a>.
        </p>
      </div>
    </section>

    <section class="fc-trust-section" id="colophon">
      <h2 class="fc-trust-h2">Independence Colophon</h2>
      <div class="fc-trust-prose">
        <p>
          <strong>The Financial Crimes</strong> is an independent digital publication and has
          <strong>no affiliation, sponsorship, or endorsement</strong> from{' '}
          <em>The New York Times</em>, any government agency, financial regulator, law firm, or
          corporate entity covered in its pages.
        </p>
        <p>
          Reader sign-ups, public-filing tip submissions, and direct correction intake are
          <strong>coming soon</strong>. Until then, follow new editions via our{' '}
          <a href="/rss.xml">RSS feed</a>, browse past issues in the{' '}
          <a href="/archive">Edition Archive</a>, and review our{' '}
          <a href="/corrections">Corrections &amp; Legal Updates</a> log.
        </p>
      </div>
    </section>

    <section class="fc-trust-section" id="image-credits">
      <h2 class="fc-trust-h2">Reference Portrait Attributions &amp; Licenses</h2>
      <div class="fc-trust-prose">
        <p>
          Every editorial illustration on The Financial Crimes is procedurally rendered in HTML5
          Canvas as an impressionist oil study derived from open-licensed or public-domain
          reference photographs ({creditRows.length} cataloged studies). In full compliance with
          Creative Commons (CC BY / CC BY-SA), Open Government Licence (OGL), and CC0 attribution
          terms, each captioned study links directly to its reference source beneath its article
          frame and in our searchable credits directory.
        </p>

        <div class="fc-credits-license-strip" aria-label="License distribution">
          {licenseSummary.map((item) => (
            <span class="fc-trust-license-badge">
              {item.license} &middot; {item.count}
            </span>
          ))}
        </div>

        <p style="margin-top: 16px;">
          <a href="/credits" class="fc-btn-outline" style="display: inline-block; text-decoration: none;">
            Browse All {creditRows.length} Reference Credits &amp; Licenses &rarr;
          </a>
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
