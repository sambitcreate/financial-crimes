---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompactHeader from '../../components/CompactHeader.astro';
import FcArt from '../../components/FcArt.astro';
import CompareStreetCrime from '../../components/CompareStreetCrime.astro';
import CrimeReceiptModal from '../../components/CrimeReceiptModal.astro';
import { loadAllArticles } from '../../loaders/articles';
import { resolvePaintRef } from '../../painting/refs-loader';
import type { ArticleRecord } from '../../schemas/article';
import { formatBroadsheetDate } from '../../utils/format';

export async function getStaticPaths() {
  const articles = await loadAllArticles();
  return articles
    .filter((a) => a.template === 'opinion')
    .map((article) => ({
      params: { slug: article.slug },
      props: { article, allArticles: articles },
    }));
}

interface Props {
  article: ArticleRecord;
  allArticles: ArticleRecord[];
}

const { article, allArticles } = Astro.props;

const bylineClean = article.byline.replace(/^By\s+/i, '').trim();
const formattedDate = formatBroadsheetDate(article.publish_date);
const monoSpec = {
  ...article.interactive_art_spec,
  theme: 'monochrome' as const,
};

const heroRef = await resolvePaintRef({
  id: `${article.id}-mono`,
  slug: article.slug,
  caption: monoSpec.caption,
});

const related = allArticles
  .filter((a) => a.slug !== article.slug)
  .sort((a, b) => (b.template === 'opinion' ? 1 : 0) - (a.template === 'opinion' ? 1 : 0))
  .slice(0, 3);

const siteBase = Astro.site ?? new URL('https://financialcrimes.fyi');
const opinionCanonicalUrl = new URL(article.url, siteBase).toString();
const ogImageUrl = new URL('/og-card.png', siteBase).toString();
const opinionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.headline,
  description: article.deck,
  datePublished: article.publish_date,
  url: opinionCanonicalUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': opinionCanonicalUrl,
  },
  image: [ogImageUrl],
  articleSection: 'Opinion',
  author: {
    '@type': 'Person',
    name: bylineClean,
  },
  publisher: {
    '@type': 'NewsMediaOrganization',
    name: 'The Financial Crimes',
    url: siteBase.toString().replace(/\/+$/, ''),
    logo: {
      '@type': 'ImageObject',
      url: ogImageUrl,
      width: 1200,
      height: 630,
    },
  },
};
---

<BaseLayout
  title={`Opinion | ${article.headline} — The Financial Crimes`}
  description={article.deck}
  canonicalPath={article.url}
  ogType="article"
  publishedTime={article.publish_date}
  jsonLd={opinionJsonLd}
  preloadImage={heroRef.entry?.refImage}
>
  <CompactHeader slot="header" showTopicBar={false} />

  <article class="fc-article-page" data-pagefind-body>
    {/* Centered Opinion Header */}
    <header class="fc-opinion-header">
      <p class="fc-opinion-eyebrow" data-pagefind-meta="category">OPINION</p>
      <p class="fc-opinion-author">{bylineClean}</p>
      <h1 class="fc-opinion-h1" data-pagefind-meta="title">{article.headline}</h1>
      <p class="fc-opinion-deck">{article.deck}</p>
      <p class="fc-opinion-date">
        {formattedDate} &middot; {article.city} &middot; {article.read_time_min} min read
      </p>

      <div style="display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center;">
        <button type="button" class="fc-btn-pill" data-open-receipt>
          <span aria-hidden="true">&#129534;</span>
          <span>Crime Receipt</span>
        </button>
        <button type="button" class="fc-btn-pill" id="fc-opinion-copy-btn">
          Share
        </button>
        {article.slap_on_wrist_score !== null && (
          <span
            class:list={[
              'fc-score-badge',
              { 'fc-score-badge--high': article.slap_on_wrist_score >= 70 },
            ]}
          >
            WRIST-SLAP {article.slap_on_wrist_score}/100
          </span>
        )}
      </div>
    </header>

    {/* Wide 945px Monochrome Impasto Painting Centerpiece */}
    <div class="fc-article-media">
      <FcArt
        id={`${article.id}-mono`}
        slug={article.slug}
        spec={monoSpec}
        mode="hero"
        aspect="16/10"
        showCaption={true}
      />
    </div>

    {/* 600px Editorial Drop-Cap Body */}
    <div class="fc-article-body fc-opinion-body" set:html={article.bodyHtml} />

    <CompareStreetCrime article={article} />

    {/* Compact Primary Filings */}
    <section class="fc-sources-box" aria-label="Primary filings">
      <h2 class="fc-sources-title">Primary Filings</h2>
      <ul class="fc-sources-list" style="margin-top: 8px;">
        {article.sources.map((src) => (
          <li>
            <div>
              <a href={src.url} target="_blank" rel="noopener noreferrer">
                {src.title} &nearr;
              </a>
              <span style="display: block; font-size: 11.5px; color: var(--fc-ink-muted);">
                {src.agency}
              </span>
            </div>
            <span class="fc-sources-meta">{formatBroadsheetDate(src.date)}</span>
          </li>
        ))}
      </ul>
    </section>

    {/* Related Opinion & Dispatches */}
    {related.length > 0 && (
      <section class="fc-related-section" aria-label="More from the Ledger" data-pagefind-ignore>
        <h2 class="fc-related-heading">More From the Ledger</h2>
        <div class="fc-related-grid">
          {related.map((rel) => (
            <article class="fc-related-card">
              <a href={rel.url} aria-label={rel.headline} style="border: 1px solid var(--fc-rule-light);">
                <FcArt
                  id={`${rel.id}-op-rel`}
                  slug={rel.slug}
                  spec={rel.template === 'opinion' ? { ...rel.interactive_art_spec, theme: 'monochrome' } : rel.interactive_art_spec}
                  mode="thumb"
                  aspect="16/10"
                  showCaption={false}
                />
              </a>
              {rel.template === 'opinion' && (
                <span class="fc-eyebrow fc-eyebrow--opinion">OPINION</span>
              )}
              <h3 class="fc-related-card-title">
                <a href={rel.url} class="fc-headline-link">{rel.headline}</a>
              </h3>
              <span class="fc-meta-readtime">{rel.city} &middot; {rel.read_time_min} MIN READ</span>
            </article>
          ))}
        </div>
      </section>
    )}
  </article>

  <CrimeReceiptModal slot="modals" article={article} />
</BaseLayout>

<script>
  const copyBtn = document.getElementById('fc-opinion-copy-btn');
  copyBtn?.addEventListener('click', async () => {
    const orig = copyBtn.dataset.label ?? (copyBtn.dataset.label = copyBtn.textContent ?? '');
    try {
      await navigator.clipboard.writeText(window.location.href);
    } catch {
      return;
    }
    copyBtn.textContent = 'Copied';
    window.clearTimeout(Number(copyBtn.dataset.resetTimer));
    copyBtn.dataset.resetTimer = String(
      window.setTimeout(() => {
        copyBtn.textContent = orig;
      }, 1500),
    );
  });
</script>
