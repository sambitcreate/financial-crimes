# =============================================================================
# The Financial Crimes — Environment Variables & GitHub Actions Secrets/Vars
# Copy to `.env` for local overrides (`.env` is gitignored).
# None of these are required for local `npm run dev`, `npm test`, or `npm run build`.
# =============================================================================

# --- Site Configuration (Build-Time) -----------------------------------------
# Canonical public origin used by Astro sitemap, RSS feed, and OpenGraph tags.
# Defaults to https://financialcrimes.fyi when unset.
SITE_URL=https://financialcrimes.fyi

# --- Gemini API (Editorial Scoring & Phase 2 Pipeline) -----------------------
# Required for `npm run judge:slap` and Phase 2 `pipeline/run-sweep.mjs --mode sweep`.
# Store as a GitHub Actions Repository Secret for scheduled/manual workflow runs.
GEMINI_API_KEY=

# Optional model override for `judge:slap` and `pipeline/run-sweep.mjs`.
# In GitHub Actions, set as a Repository Variable (`vars.GEMINI_MODEL`);
# daily-sweep.yml defaults to `gemini-2.5-pro` when unset.
GEMINI_MODEL=gemini-2.5-pro

# --- Cloudflare Workers Static Assets Deploy (GitHub Actions) ----------------
# Not required if deploying via Cloudflare Workers Git Integration directly.
# If deploying via `.github/workflows/ci.yml`:
#   - Set CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID as Repository Secrets
#   - Set CLOUDFLARE_DEPLOY_ENABLED=true as a Repository Variable (`vars.*`)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DEPLOY_ENABLED=false

# --- Optional Phase 2: Antigravity Managed Remote Agent ----------------------
# Store as GitHub Actions Repository Secrets if delegating the 6:00 AM ET
# sweep to a managed Antigravity remote worker.
ANTIGRAVITY_AGENT_ENDPOINT=
ANTIGRAVITY_AGENT_TOKEN=
