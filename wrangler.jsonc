{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financial-crimes",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
